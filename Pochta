Import-Module ActiveDirectory

$FilePath = "C:\Users\z-BorodinES\Desktop\Reports_Отчеты с подписками_построчно.xlsx"

$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    Write-Host "Открываем файл $FilePath..." -ForegroundColor Cyan
    $wb = $excel.Workbooks.Open($FilePath)
    $ws = $wb.Sheets.Item("Лист1") 
    
    $lastRow = $ws.UsedRange.Rows.Count
    
    $emailCol = 0
    $lastCol = $ws.UsedRange.Columns.Count
    for ($c = 1; $c -le $lastCol; $c++) {
        if ($ws.Cells.Item(1, $c).Text -eq "Значение") {
            $emailCol = $c
            break
        }
    }
    
    if ($emailCol -eq 0) {
        Write-Host "[!] Столбец 'Значение' не найден! Берем 4-й столбец (D)." -ForegroundColor Yellow
        $emailCol = 4 
    }
    
    # Ставим заголовки в столбцы E (5) и F (6)
    $ws.Cells.Item(1, 5).Value2 = "Статус в AD"
    $ws.Cells.Item(1, 6).Value2 = "Почта из AD (если другая)"

    Write-Host "Начинаем каскадную проверку почт в AD..." -ForegroundColor Cyan

    for ($row = 2; $row -le $lastRow; $row++) {
        $email = $ws.Cells.Item($row, $emailCol).Text.Trim()
        
        if ([string]::IsNullOrWhiteSpace($email)) {
            continue
        }
        
        $status = "не найден"
        $newEmail = ""
        
        # 1. Ищем по Email и сразу забираем DisplayName (чтобы знать ФИО, если придется искать двойника)
        $usersByEmail = @(Get-ADUser -Filter "mail -eq '$email'" -Properties Enabled, msExchHideFromAddressLists, msExchMailboxGuid, DisplayName -ErrorAction SilentlyContinue)
        
        if ($usersByEmail.Count -gt 0) {
            $emailActive = $false
            $emailInAB = $false
            $emailHasMb = $false
            $targetName = ""
            
            # Разбираем все учётки, привязанные к этой почте
            foreach ($u in $usersByEmail) {
                if ($u.Enabled) { $emailActive = $true }
                if ($null -eq $u.msExchHideFromAddressLists -or $u.msExchHideFromAddressLists -eq $false) { $emailInAB = $true }
                if ($null -ne $u.msExchMailboxGuid) { $emailHasMb = $true }
                
                # Запоминаем ФИО из первой попавшейся непустой учётки
                if ([string]::IsNullOrWhiteSpace($targetName) -and -not [string]::IsNullOrWhiteSpace($u.DisplayName)) {
                    $targetName = $u.DisplayName
                }
            }
            
            # Если хоть одна учётка по этой почте активна - всё супер
            if ($emailActive) {
                $status = "активный"
            } 
            else {
                # 2. Почта мертва. Ищем активного "двойника" по вытащенному ФИО
                $activeTwin = $null
                
                if (-not [string]::IsNullOrWhiteSpace($targetName)) {
                    $usersByName = @(Get-ADUser -Filter "DisplayName -eq '$targetName'" -Properties Enabled, mail -ErrorAction SilentlyContinue)
                    # Ищем среди них активного
                    $activeTwin = $usersByName | Where-Object { $_.Enabled } | Select-Object -First 1
                }
                
                if ($activeTwin) {
                    # Нашли активного человека с таким же ФИО!
                    $status = "учётная запись активна, но у пользователя другая почта"
                    if (-not [string]::IsNullOrWhiteSpace($activeTwin.mail)) {
                        $newEmail = $activeTwin.mail
                    } else {
                        $newEmail = "почта не указана"
                    }
                } 
                else {
                    # 3. Живых двойников нет. Применяем логику детализации для неактивного пользователя
                    if ($emailInAB) {
                        $status = "пользователь отключён но есть в адресной книге"
                    } elseif ($emailHasMb) {
                        $status = "учётная запись не активна, нет в адресной книге, но почтовый ящик существует"
                    } else {
                        $status = "не активен"
                    }
                }
            }
        }
        
        # Пишем в Excel (E и F)
        $ws.Cells.Item($row, 5).Value2 = $status
        $ws.Cells.Item($row, 6).Value2 = $newEmail
        
        Write-Host "Строка ${row}: $email -> $status"
    }

    $wb.Save()
    Write-Host "`n[+] Готово! Файл успешно обновлен и сохранен." -ForegroundColor Green
}
catch {
    Write-Host "[!] Произошла ошибка: $_" -ForegroundColor Red
}
finally {
    if ($null -ne $wb) { $wb.Close($false) }
    $excel.Quit()
    [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
    [System.GC]::Collect()
    [System.GC]::WaitForPendingFinalizers()
}




Import-Module ActiveDirectory

$FilePath = "C:\Users\z-BorodinES\Desktop\Qlik_Отчеты с Рассылками_14.08.26..xlsx"

$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    Write-Host "Открываем файл $FilePath..." -ForegroundColor Cyan
    $wb = $excel.Workbooks.Open($FilePath)
    $ws = $wb.Sheets.Item("Sheet1") 
    
    $lastRow = $ws.UsedRange.Rows.Count
    
    $emailCol = 0
    $nameCol = 0
    $lastCol = $ws.UsedRange.Columns.Count
    for ($c = 1; $c -le $lastCol; $c++) {
        $headerName = $ws.Cells.Item(1, $c).Text.Trim()
        if ($headerName -eq "user_email") { $emailCol = $c }
        if ($headerName -eq "user_name")  { $nameCol = $c }
    }
    
    if ($emailCol -eq 0 -or $nameCol -eq 0) {
        Write-Host "[!] Не найдены столбцы 'user_email' или 'user_name'! Скрипт остановлен." -ForegroundColor Red
        return
    }
    
    $ws.Cells.Item(1, 10).Value2 = "Статус в AD"
    $ws.Cells.Item(1, 11).Value2 = "Почта из AD (если другая)"

    Write-Host "Начинаем каскадную проверку пользователей..." -ForegroundColor Cyan

    for ($row = 2; $row -le $lastRow; $row++) {
        $email = $ws.Cells.Item($row, $emailCol).Text.Trim()
        $name  = $ws.Cells.Item($row, $nameCol).Text.Trim()
        
        $status = "не найден"
        $newEmail = ""
        
        if ([string]::IsNullOrWhiteSpace($email) -and [string]::IsNullOrWhiteSpace($name)) {
            continue
        }

        # === ЭТАП 1: Поиск по Email ===
        $usersByEmail = @()
        if (-not [string]::IsNullOrWhiteSpace($email)) {
            $usersByEmail = @(Get-ADUser -Filter "mail -eq '$email'" -Properties Enabled, msExchHideFromAddressLists, msExchMailboxGuid -ErrorAction SilentlyContinue)
        }
        
        $emailActive = $false
        $emailInAB = $false
        $emailHasMb = $false
        
        foreach ($u in $usersByEmail) {
            if ($u.Enabled) { $emailActive = $true }
            if ($null -eq $u.msExchHideFromAddressLists -or $u.msExchHideFromAddressLists -eq $false) { $emailInAB = $true }
            if ($null -ne $u.msExchMailboxGuid) { $emailHasMb = $true }
        }

        # Если по почте найден активный человек - дальше не ищем
        if ($emailActive) {
            $status = "активный"
        } 
        else {
            # === ЭТАП 2: Поиск по ФИО (ищем активного "близнеца" или данные для неактивного) ===
            $usersByName = @()
            $activeTwin = $null
            
            if (-not [string]::IsNullOrWhiteSpace($name)) {
                $usersByName = @(Get-ADUser -Filter "DisplayName -eq '$name'" -Properties Enabled, mail, msExchHideFromAddressLists, msExchMailboxGuid -ErrorAction SilentlyContinue)
                # Пытаемся найти активную учетку среди тех, что нашлись по ФИО
                $activeTwin = $usersByName | Where-Object { $_.Enabled } | Select-Object -First 1
            }

            # Если мы нашли активного двойника по ФИО
            if ($activeTwin) {
                $status = "учётная запись активна, но у пользователя другая почта"
                if (-not [string]::IsNullOrWhiteSpace($activeTwin.mail)) {
                    $newEmail = $activeTwin.mail
                } else {
                    $newEmail = "почта не указана"
                }
            } 
            else {
                # === ЭТАП 3: Активных нет вообще. Разбираем неактивные учётки ===
                
                if ($usersByEmail.Count -gt 0) {
                    # Сценарий А: Пользователь найден по старой почте, но он мертв
                    if ($emailInAB) {
                        $status = "пользователь отключён но есть в адресной книге"
                    } elseif ($emailHasMb) {
                        $status = "учётная запись не активна, нет в адресной книге, но почтовый ящик существует"
                    } else {
                        $status = "не активен"
                    }
                } 
                elseif ($usersByName.Count -gt 0) {
                    # Сценарий Б: По почте вообще пусто, но нашли мертвую учетку по ФИО
                    $nameInAB = $false
                    $nameHasMb = $false
                    
                    foreach ($u in $usersByName) {
                        if ($null -eq $u.msExchHideFromAddressLists -or $u.msExchHideFromAddressLists -eq $false) { $nameInAB = $true }
                        if ($null -ne $u.msExchMailboxGuid) { $nameHasMb = $true }
                    }
                    
                    # Берем почту первой попавшейся неактивной учетки
                    $target = $usersByName[0]
                    if (-not [string]::IsNullOrWhiteSpace($target.mail)) {
                        $newEmail = $target.mail
                    } else {
                        $newEmail = "почта не указана"
                    }
                    
                    if ($nameInAB) {
                        $status = "неактивна, есть в адресной книге, почта другая"
                    } elseif ($nameHasMb) {
                        $status = "неактивна, нет в адресной книге, но почтовый ящик существует, почта другая"
                    } else {
                        $status = "неактивна, нет в адресной книге, почта другая"
                    }
                } 
                else {
                    # Сценарий В: Вообще никого не нашли
                    $status = "не найден"
                }
            }
        }
        
        $ws.Cells.Item($row, 10).Value2 = $status
        $ws.Cells.Item($row, 11).Value2 = $newEmail
        Write-Host "Строка ${row}: $email / $name -> $status"
    }

    $wb.Save()
    Write-Host "`n[+] Готово! Статусы записаны в столбцы J и K." -ForegroundColor Green
}
catch {
    Write-Host "[!] Произошла ошибка: $_" -ForegroundColor Red
}
finally {
    if ($null -ne $wb) { $wb.Close($false) }
    $excel.Quit()
    [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
    [System.GC]::Collect()
    [System.GC]::WaitForPendingFinalizers()
}
