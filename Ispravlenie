cls
Import-Module ActiveDirectory

# ==============================================================================
# НАСТРОЙКИ ПУТЕЙ
# ==============================================================================
$SourceExcelPath = "C:\Users\z-BorodinES\Desktop\SourceGroups.xlsx"       # Исходный файл
$TargetExcelPath = "C:\Users\z-BorodinES\Desktop\GroupMembersCount.xlsx" # Файл с результатами

# ==============================================================================
# ОСНОВНАЯ ЛОГИКА
# ==============================================================================

Write-Host "Запуск Excel..." -ForegroundColor Cyan
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    Write-Host "Чтение исходного файла $SourceExcelPath..." -ForegroundColor Cyan
    $wbSource = $excel.Workbooks.Open($SourceExcelPath)
    $wsSource = $wbSource.Worksheets.Item(1)
    $lastRow = $wsSource.Cells.SpecialCells(11).Row 

    $results = @()

    Write-Host "Подсчет участников групп в Active Directory..." -ForegroundColor Yellow

    for ($i = 2; $i -le $lastRow; $i++) {
        $groupName  = $wsSource.Cells.Item($i, 1).Text
        $objectPath = $wsSource.Cells.Item($i, 4).Text # Путь из Object

        if ([string]::IsNullOrWhiteSpace($groupName)) { continue }
        
        $cleanGroup = $groupName.Trim()
        Write-Host "Обработка [$i / $lastRow]: $cleanGroup"
        
        $memberCount = 0

        try {
            # Оборачиваем в @(), чтобы .Count работал правильно, даже если в группе 1 человек
            $members = @(Get-ADGroupMember -Identity $cleanGroup -ErrorAction Stop)
            $memberCount = $members.Count
            Write-Host "  -> Участников: $memberCount" -ForegroundColor Green
        }
        catch {
            $memberCount = "Ошибка AD: Группа не найдена или нет доступа"
            Write-Host "  -> Ошибка: $($_.Exception.Message)" -ForegroundColor Red
        }

        # Собираем данные для нового файла
        $results += [PSCustomObject]@{
            GroupName   = $cleanGroup
            MemberCount = $memberCount
            ObjectPath  = $objectPath
        }
    }

    $wbSource.Close($false)

    # --- Создание нового Excel файла ---
    Write-Host "Создание нового файла $TargetExcelPath..." -ForegroundColor Cyan
    $wbTarget = $excel.Workbooks.Add()
    $wsTarget = $wbTarget.Worksheets.Item(1)

    # Заголовки
    $wsTarget.Cells.Item(1, 1).Value2 = "Имя группы"
    $wsTarget.Cells.Item(1, 2).Value2 = "Количество человек"
    $wsTarget.Cells.Item(1, 3).Value2 = "Путь из Object"
    
    $wsTarget.Range("A1:C1").Font.Bold = $true

    # Запись данных
    $rowTarget = 2
    foreach ($item in $results) {
        $wsTarget.Cells.Item($rowTarget, 1).Value2 = $item.GroupName
        $wsTarget.Cells.Item($rowTarget, 2).Value2 = $item.MemberCount
        $wsTarget.Cells.Item($rowTarget, 3).Value2 = $item.ObjectPath
        $rowTarget++
    }

    # Автоподбор ширины столбцов
    [void]$wsTarget.Columns.AutoFit()

    if (Test-Path $TargetExcelPath) { Remove-Item $TargetExcelPath -Force }
    $wbTarget.SaveAs($TargetExcelPath)
    $wbTarget.Close($true)

    Write-Host "Готово! Результат сохранен в: $TargetExcelPath" -ForegroundColor Green
}
catch {
    Write-Error "Произошла глобальная ошибка: $_"
}
finally {
    if ($null -ne $excel) {
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.GC]::Collect()
        [System.GC]::WaitForPendingFinalizers()
    }
}
