Import-Module ActiveDirectory

$OutputFile = "C:\Users\z-BorodinES\Desktop\Отчет_по_группам_FS.xlsx"

# Точный путь, скопированный из атрибутов AD
$SearchBase = "OU=R: Departments,OU=Department FS Access Groups,OU=Файловые серверы ABCloud,OU=ABCloud,OU=Серверы и ресурсы,OU=Головной офис,DC=abb-win,DC=akbars,DC=ru"

Write-Host "Получение списка групп из конкретной OU..." -ForegroundColor Cyan

# Добавили CanonicalName (это и есть путь из вкладки Object)
$groups = Get-ADGroup -Filter * -SearchBase $SearchBase -Properties info, CanonicalName

Write-Host "Найдено групп: $($groups.Count). Начинается проверка путей..." -ForegroundColor Cyan

$ResultData = @()

foreach ($group in $groups) {
    $groupName = $group.Name
    $objectPath = $group.CanonicalName
    
    # Очищаем путь от переносов строк и лишних пробелов, если поле info заполнено
    if ($null -ne $group.info) {
        $folderPath = $group.info -replace "[\r\n]", " "
        $folderPath = $folderPath.Trim()
    } else {
        $folderPath = ""
    }

    if ([string]::IsNullOrWhiteSpace($folderPath)) {
        $status = "Путь не указан"
    # Проверяем, начинается ли строка с \\ или // (с учетом возможных пробелов в начале)
    } elseif ($folderPath -match "^[\\/]{2}") {
        try {
            if (Test-Path -LiteralPath $folderPath -ErrorAction Stop) {
                $status = "Существует"
            } else {
                $status = "Не существует"
            }
        } catch {
            $status = "Некорректный формат пути"
        }
    } else {
        # Если строка начинается не с двойного слеша — сразу бракуем
        $status = "Некорректный формат пути"
    }

    $ResultData += [PSCustomObject]@{
        GroupName  = $groupName
        Path       = $folderPath
        Status     = $status
        ObjectPath = $objectPath
    }
}

if ($groups.Count -gt 0) {
    Write-Host "Запись данных в Excel..." -ForegroundColor Cyan

    $excel = New-Object -ComObject Excel.Application
    $excel.Visible = $false
    $excel.DisplayAlerts = $false

    try {
        $workbook = $excel.Workbooks.Add()
        $worksheet = $workbook.Sheets.Item(1)

        # Добавили четвертый заголовок
        $worksheet.Cells.Item(1, 1).Value2 = "Имя группы"
        $worksheet.Cells.Item(1, 2).Value2 = "Путь (из Notes)"
        $worksheet.Cells.Item(1, 3).Value2 = "Статус пути"
        $worksheet.Cells.Item(1, 4).Value2 = "Путь из Object"

        $worksheet.Rows.Item(1).Font.Bold = $true

        $row = 2
        foreach ($item in $ResultData) {
            $worksheet.Cells.Item($row, 1).Value2 = $item.GroupName
            $worksheet.Cells.Item($row, 2).Value2 = $item.Path
            $worksheet.Cells.Item($row, 3).Value2 = $item.Status
            $worksheet.Cells.Item($row, 4).Value2 = $item.ObjectPath
            $row++
        }

        [void]$worksheet.Columns.AutoFit()

        $workbook.SaveAs($OutputFile)
        Write-Host "Файл успешно сохранен: $OutputFile" -ForegroundColor Green
    }
    catch {
        Write-Host "[!] Произошла ошибка при работе с Excel: $_" -ForegroundColor Red
    }
    finally {
        if ($null -ne $workbook) { $workbook.Close($false) }
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.GC]::Collect()
        [System.GC]::WaitForPendingFinalizers()
    }

    # Открываем файл ПОСЛЕ того, как COM-объект закрыт
    Invoke-Item $OutputFile
} else {
    Write-Host "Не найдено ни одной группы в указанной OU. Проверь путь SearchBase." -ForegroundColor Yellow
}
