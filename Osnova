cls
Import-Module ActiveDirectory

# ==============================================================================
# НАСТРОЙКИ
# ==============================================================================
$TargetExcelPath = "C:\Users\z-BorodinES\Desktop\Sizing_Report_AD.xlsx"
$SearchBase = "OU=R: Departments,OU=Department FS Access Groups,OU=Файловые серверы ABCloud,OU=ABCloud,OU=Серверы и ресурсы,OU=Головной офис,DC=abb-win,DC=akbars,DC=ru"
$MaxThreads = 4

# ==============================================================================
# ШАГ 1: ПОЛУЧЕНИЕ ГРУПП ИЗ AD
# ==============================================================================
Write-Host "Получение групп из OU..." -ForegroundColor Cyan
$allGroups = Get-ADGroup -Filter * -SearchBase $SearchBase -Properties department, info

# Фильтруем: оставляем только те группы, где есть department И есть путь в info (Notes)
$validGroups = $allGroups | Where-Object { 
    (-not [string]::IsNullOrWhiteSpace($_.department)) -and 
    (-not [string]::IsNullOrWhiteSpace($_.info)) 
}

Write-Host "Найдено групп с заполненным Департаментом и Notes: $($validGroups.Count)" -ForegroundColor Green

if ($validGroups.Count -eq 0) {
    Write-Host "Нет данных для обработки. Выход." -ForegroundColor Yellow
    return
}

# ==============================================================================
# ШАГ 2: НАСТРОЙКА МНОГОПОТОЧНОСТИ
# ==============================================================================
Write-Host "`nЗапуск многопоточного сканирования Robocopy ($MaxThreads потока)..." -ForegroundColor Yellow

$RunspacePool = [runspacefactory]::CreateRunspacePool(1, $MaxThreads)
$RunspacePool.Open()
$Jobs = @()

# Блок кода, который будет выполняться внутри каждого потока
$ScriptBlock = {
    param($GroupName, $Department, $RawNotesPath)

    # 1. Очистка пути
    $cleanPath = $RawNotesPath -replace "[\r\n]", " "
    $cleanPath = $cleanPath.Trim()
    
    if ($cleanPath -match '(\\\\.*)') {
        $cleanPath = $matches[1].TrimEnd('\')
    } else {
        return $null # Некорректный путь
    }

    # 2. Определение TargetPath (резолв DFS, если это DFS)
    $targetPath = $cleanPath
    try {
        # Пытаемся получить реальный путь через системную утилиту (без вывода ошибок)
        $dfsResult = & dfsutil link $cleanPath 2>$null
        if ($dfsResult -match 'Target:\s+(\\\\.*)') {
            $targetPath = $matches[1].Trim()
        }
    } catch { }

    # 3. Настройка Robocopy
    $Date3Years = (Get-Date).AddYears(-3)
    $Date5Years = (Get-Date).AddYears(-5)

    if (-not (Test-Path -LiteralPath $cleanPath -ErrorAction SilentlyContinue)) {
        return [PSCustomObject]@{
            BusinessBlock = $Department
            GroupName     = $GroupName
            NotesPath     = $cleanPath
            TargetPath    = "НЕДОСТУПЕН"
            TotalGB       = 0
            Old3YearsGB   = 0
            Old5YearsGB   = 0
        }
    }

    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = "robocopy.exe"
    $psi.Arguments = "`"$cleanPath`" NUL /L /E /XJ /BYTES /FP /TS /NC /NJH /NJS /NDL /R:0 /W:0 /NP"
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow = $true
    $psi.RedirectStandardOutput = $true
    $psi.StandardOutputEncoding = [System.Text.Encoding]::GetEncoding(866)

    $process = [System.Diagnostics.Process]::Start($psi)

    [long]$TotalBytes = 0
    [long]$Old3Bytes  = 0
    [long]$Old5Bytes  = 0

    $regex = [regex]'^\s*(\d+)\s+(\d{4}/\d{2}/\d{2}\s+\d{2}:\d{2}:\d{2})\s'

    # 4. Чтение потока Robocopy "на лету"
    while (($line = $process.StandardOutput.ReadLine()) -ne $null) {
        $match = $regex.Match($line)
        if ($match.Success) {
            $Bytes = [long]$match.Groups[1].Value
            $FileDate = [datetime]::ParseExact($match.Groups[2].Value, "yyyy/MM/dd HH:mm:ss", $null)

            $TotalBytes += $Bytes

            if ($FileDate -lt $Date3Years) { $Old3Bytes += $Bytes }
            if ($FileDate -lt $Date5Years) { $Old5Bytes += $Bytes }
        }
    }

    $process.WaitForExit()
    $process.Dispose()

    # Формируем итоговый объект
    return [PSCustomObject]@{
        BusinessBlock = $Department
        GroupName     = $GroupName
        NotesPath     = $cleanPath
        TargetPath    = $targetPath
        TotalGB       = [math]::Round($TotalBytes / 1GB, 2)
        Old3YearsGB   = [math]::Round($Old3Bytes  / 1GB, 2)
        Old5YearsGB   = [math]::Round($Old5Bytes  / 1GB, 2)
    }
}

# ==============================================================================
# ШАГ 3: РАЗДАЧА ЗАДАЧ ПОТОКАМ
# ==============================================================================
foreach ($group in $validGroups) {
    $PowerShell = [powershell]::Create()
    $PowerShell.RunspacePool = $RunspacePool
    [void]$PowerShell.AddScript($ScriptBlock)
    [void]$PowerShell.AddArgument($group.Name)
    [void]$PowerShell.AddArgument($group.department)
    [void]$PowerShell.AddArgument($group.info)
    
    $Jobs += [PSCustomObject]@{
        Pipe = $PowerShell
        Result = $PowerShell.BeginInvoke()
    }
}

# Ожидание результатов с прогресс-баром
$completedCount = 0
$totalJobs = $Jobs.Count
$Results = @()

while ($Jobs.Result.IsCompleted -contains $false) {
    foreach ($job in $Jobs) {
        if ($job.Result.IsCompleted -and $null -eq $job.Checked) {
            $job.Checked = $true
            $completedCount++
            
            $jobResult = $job.Pipe.EndInvoke($job.Result)
            if ($jobResult) { $Results += $jobResult }
            
            Write-Host "Обработано путей: $completedCount из $totalJobs" -ForegroundColor DarkGray
        }
    }
    Start-Sleep -Milliseconds 200
}

# Очистка потоков
foreach ($job in $Jobs) { $job.Pipe.Dispose() }
$RunspacePool.Close()
$RunspacePool.Dispose()

# ==============================================================================
# ШАГ 4: ЗАПИСЬ РЕЗУЛЬТАТОВ В EXCEL
# ==============================================================================
Write-Host "`nСохранение отчета в Excel..." -ForegroundColor Cyan
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    $wb = $excel.Workbooks.Add()
    $ws = $wb.Worksheets.Item(1)
    $ws.Name = "Диск R"

    # Заголовки
    $ws.Cells.Item(1, 1).Value2 = "Блок бизнеса"
    $ws.Cells.Item(1, 2).Value2 = "Имя группы"
    $ws.Cells.Item(1, 3).Value2 = "Путь(Notes)"
    $ws.Cells.Item(1, 4).Value2 = "TargetPath"
    $ws.Cells.Item(1, 5).Value2 = "Общий размер папки, в Gb"
    $ws.Cells.Item(1, 6).Value2 = "Файлы старше 3х лет, в Gb"
    $ws.Cells.Item(1, 7).Value2 = "Файлы старше 5 лет, в Gb"

    $ws.Range("A1:G1").Font.Bold = $true

    $row = 2
    foreach ($res in $Results) {
        $ws.Cells.Item($row, 1).Value2 = $res.BusinessBlock
        $ws.Cells.Item($row, 2).Value2 = $res.GroupName
        $ws.Cells.Item($row, 3).Value2 = $res.NotesPath
        $ws.Cells.Item($row, 4).Value2 = $res.TargetPath
        $ws.Cells.Item($row, 5).Value2 = $res.TotalGB
        $ws.Cells.Item($row, 6).Value2 = $res.Old3YearsGB
        $ws.Cells.Item($row, 7).Value2 = $res.Old5YearsGB
        $row++
    }

    [void]$ws.Columns.AutoFit()

    if (Test-Path $TargetExcelPath) { Remove-Item $TargetExcelPath -Force }
    $wb.SaveAs($TargetExcelPath)
    $wb.Close($true)

    Write-Host "УСПЕХ! Файл сохранен: $TargetExcelPath" -ForegroundColor Green
}
catch {
    Write-Error "Ошибка при работе с Excel: $_"
}
finally {
    if ($null -ne $excel) {
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.GC]::Collect()
        [System.GC]::WaitForPendingFinalizers()
    }
}
