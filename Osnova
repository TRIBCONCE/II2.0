cls
# ==============================================================================
# НАСТРОЙКИ ПУТЕЙ
# ==============================================================================
$SourceExcelPath = "C:\Users\z-BorodinES\Desktop\FoundGroups.xlsx"
$TargetExcelPath = "C:\Users\z-BorodinES\Desktop\FoundGroups_AppDS.xlsx"

$AppDS_SearchBase = "\\p-fsglo-gl02f.abb-win.akbars.ru\AppDS" 
$MaxDepth = 5

# ==============================================================================
# ФУНКЦИЯ ПОИСКА: ROBOCOPY + BFS-СОРТИРОВКА + ЖИВОЙ СЧЕТЧИК
# ==============================================================================
function Search-GroupInAppDS {
    param (
        [string]$BasePath,
        [string]$GroupName,
        [int]$DepthLimit = 5
    )

    # 1. Собираем структуру через Robocopy (ОДИН РАЗ)
    if ($null -eq $global:RoboFolderCache) {
        Write-Host "  -> [КЭШ ПУСТ] Запуск Robocopy (до $DepthLimit уровней) для базового пути..." -ForegroundColor Magenta
        
        $tempLog = Join-Path $env:TEMP "robo_cache_$([guid]::NewGuid().Guid).log"
        $roboArgs = @(
            $BasePath, "NULL", 
            "/L", "/E", "/LEV:$DepthLimit", "/XJ", 
            "/NFL", "/NC", "/NS", "/NJH", "/NJT", "/R:0", "/W:0",
            "/UNILOG:$tempLog" # Решает проблему с русскими буквами
        )
        
        & robocopy $roboArgs | Out-Null
        
        $tempList = [System.Collections.Generic.List[string]]::new()
        
        if (Test-Path -LiteralPath $tempLog) {
            foreach ($line in (Get-Content -LiteralPath $tempLog)) {
                if ($line -match '([a-zA-Z]:\\.*|\\\\.*)') {
                    $folderPath = $matches[1].TrimEnd('\').Trim()
                    if (Test-Path -LiteralPath $folderPath -PathType Container -ErrorAction SilentlyContinue) {
                        $tempList.Add($folderPath)
                    }
                }
            }
            Remove-Item -LiteralPath $tempLog -Force
        }
        
        Write-Host "  -> [СОРТИРОВКА] Выстраиваем пути по уровням (эмуляция BFS)..." -ForegroundColor Yellow
        
        # СОРТИРОВКА ПО ГЛУБИНЕ (от корня вглубь)
        # Считаем количество слешей в пути. Чем их меньше - тем выше папка.
        $global:RoboFolderCache = $tempList | Sort-Object { ($_ -split '\\').Count }
        
        Write-Host "  -> [КЭШ ГОТОВ] Папок в памяти: $($global:RoboFolderCache.Count)" -ForegroundColor Green
    }

    # 2. Ищем группу в отсортированном кэше
    $cleanGroup = $GroupName.Trim()
    $totalFolders = $global:RoboFolderCache.Count
    $checkedCount = 0

    foreach ($folder in $global:RoboFolderCache) {
        $checkedCount++
        
        # Индикатор жизни, чтобы не казалось, что скрипт завис (каждые 500 папок)
        if ($checkedCount % 500 -eq 0) {
            Write-Host "     ... Проверено прав (Get-Acl): $checkedCount из $totalFolders" -ForegroundColor DarkGray
        }

        try {
            $acl = (Get-Acl -LiteralPath $folder -ErrorAction Stop).Access
            
            foreach ($rule in $acl) {
                # Отрезаем домен ABB-WIN\ и сравниваем чистое имя
                $aclCleanName = $rule.IdentityReference.Value.Split('\')[-1].Trim()
                
                if ($aclCleanName -eq $cleanGroup) {
                    Write-Host "     -> Найдено на шаге $checkedCount!" -ForegroundColor Green
                    return $folder
                }
            }
        }
        catch {
            # Папку нельзя прочитать - идем дальше
        }
    }
    
    return $null 
}

# ==============================================================================
# ОСНОВНАЯ ЛОГИКА
# ==============================================================================

Write-Host "Запуск Excel..." -ForegroundColor Cyan
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    Write-Host "Чтение исходного файла $SourceExcelPath..." -ForegroundColor Cyan
    $wbSource = $excel.Workbooks.Open($SourceExcelPath)
    $wsSource = $wbSource.Worksheets.Item(1)
    $lastRow = $wsSource.Cells.SpecialCells(11).Row 

    $results = @()

    for ($i = 2; $i -le $lastRow; $i++) {
        $groupName = $wsSource.Cells.Item($i, 1).Text
        $status    = $wsSource.Cells.Item($i, 2).Text
        $details   = $wsSource.Cells.Item($i, 3).Text 

        if ([string]::IsNullOrWhiteSpace($groupName)) { continue }

        Write-Host "Обработка [$i / $lastRow]: $groupName"

        if ($details -match "Users-APPsFileExchange") {
            Write-Host "  -> Триггер 'Users-APPsFileExchange' найден. Ищем группу в AppDS..." -ForegroundColor Yellow
            
            $foundAppDS = Search-GroupInAppDS -BasePath $AppDS_SearchBase -GroupName $groupName -DepthLimit $MaxDepth

            if ($foundAppDS) {
                $status  = "Найдено (AppDS)"
                $details = $foundAppDS
                Write-Host "  -> НАЙДЕНО: $details" -ForegroundColor Green
            } else {
                $status  = "Группа не найдена (AppDS)"
                $details = "Не найдено в пределах $MaxDepth уровней в $AppDS_SearchBase"
                Write-Host "  -> Не найдено (обошли все доступные папки)" -ForegroundColor DarkYellow
            }
        }
        else {
            Write-Host "  -> Обычная группа, переносим без изменений." -ForegroundColor Gray
        }

        $results += [PSCustomObject]@{
            GroupName = $groupName
            Status    = $status
            Details   = $details
        }
    }

    $wbSource.Close($false)

    # --- Создание нового Excel файла ---
    Write-Host "Создание нового файла $TargetExcelPath..." -ForegroundColor Cyan
    $wbTarget = $excel.Workbooks.Add()
    $wsTarget = $wbTarget.Worksheets.Item(1)

    $wsTarget.Cells.Item(1, 1).Value2 = "Имя группы"
    $wsTarget.Cells.Item(1, 2).Value2 = "Статус"
    $wsTarget.Cells.Item(1, 3).Value2 = "Точное расположение / Описание"
    
    $wsTarget.Range("A1:C1").Font.Bold = $true

    $rowTarget = 2
    foreach ($item in $results) {
        $wsTarget.Cells.Item($rowTarget, 1).Value2 = $item.GroupName
        $wsTarget.Cells.Item($rowTarget, 2).Value2 = $item.Status
        $wsTarget.Cells.Item($rowTarget, 3).Value2 = $item.Details
        $rowTarget++
    }

    [void]$wsTarget.Columns.AutoFit()

    if (Test-Path $TargetExcelPath) { Remove-Item $TargetExcelPath -Force }
    $wbTarget.SaveAs($TargetExcelPath)
    $wbTarget.Close($true)

    Write-Host "Готово! Результат сохранен в: $TargetExcelPath" -ForegroundColor Green
}
catch {
    Write-Error "Произошла ошибка: $_"
}
finally {
    if ($excel) {
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.GC]::Collect()
        [System.GC]::WaitForPendingFinalizers()
    }
}
