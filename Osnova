cls
Import-Module ActiveDirectory

# ==============================================================================
# НАСТРОЙКИ ПУТЕЙ
# ==============================================================================
$SourceExcelPath = "C:\Users\z-BorodinES\Desktop\SourceGroups.xlsx" # Твой исходный файл
$TargetExcelPath = "C:\Users\z-BorodinES\Desktop\Groups_From_Parents.xlsx" # Новый файл с результатами

Write-Host "Запуск Excel..." -ForegroundColor Cyan
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    Write-Host "Чтение исходного файла $SourceExcelPath..." -ForegroundColor Cyan
    $wbSource = $excel.Workbooks.Open($SourceExcelPath)
    $wsSource = $wbSource.Worksheets.Item(1)
    $lastRow = $wsSource.Cells.SpecialCells(11).Row 

    $results = @()

    Write-Host "Поиск родительских групп в Active Directory..." -ForegroundColor Yellow

    for ($i = 2; $i -le $lastRow; $i++) {
        $groupName = $wsSource.Cells.Item($i, 1).Text
        
        if ([string]::IsNullOrWhiteSpace($groupName)) { continue }

        $cleanGroupName = $groupName.Trim()
        $parentName = $null
        $status = ""
        $details = ""

        # --- ЛОГИКА ВЫЧИСЛЕНИЯ ИМЕНИ РОДИТЕЛЬСКОЙ ГРУППЫ ---
        if ($cleanGroupName -match "(?i) - изменение$") {
            $parentName = $cleanGroupName -ireplace "(?i) - изменение$", " - write"
        } elseif ($cleanGroupName -match "(?i) - чтение$") {
            $parentName = $cleanGroupName -ireplace "(?i) - чтение$", " - read"
        }

        if ($parentName) {
            # Если суффикс найден, ищем родительскую группу в AD
            try {
                # Запрашиваем группу и её свойство info (Notes)
                $parentGroup = Get-ADGroup -Filter "Name -eq '$parentName'" -Properties info -ErrorAction Stop

                if ($null -ne $parentGroup) {
                    if ($null -ne $parentGroup.info -and -not [string]::IsNullOrWhiteSpace($parentGroup.info)) {
                        # Путь в Notes найден! Очищаем его от возможных переносов строк
                        $status = "Найдено через родительскую группу"
                        $details = ($parentGroup.info -replace "[\r\n]", " ").Trim()
                        Write-Host "[$i / $lastRow] УСПЕХ: $cleanGroupName -> Взято из $parentName" -ForegroundColor Green
                    } else {
                        $status = "Родительская группа найдена, но путь пуст"
                        $details = "У группы $parentName поле Notes пустое"
                        Write-Host "[$i / $lastRow] ПУСТО: У родителя $parentName нет пути" -ForegroundColor DarkYellow
                    }
                } else {
                    $status = "Родительская группа не найдена"
                    $details = "Группа $parentName не существует в AD"
                    Write-Host "[$i / $lastRow] ОШИБКА: Родитель $parentName не найден" -ForegroundColor Red
                }
            } catch {
                $status = "Ошибка при поиске в AD"
                $details = $_.Exception.Message
                Write-Host "[$i / $lastRow] ОШИБКА AD: $($_.Exception.Message)" -ForegroundColor Red
            }
        } else {
            # Если у группы нет суффикса "изменение" или "чтение"
            $status = "Нет суффикса вложенности"
            $details = "Группу нужно искать другими методами"
            Write-Host "[$i / $lastRow] ПРОПУСК: $cleanGroupName (нет суффикса)" -ForegroundColor Gray
        }

        # Собираем данные для нового файла
        $results += [PSCustomObject]@{
            GroupName = $cleanGroupName
            Status    = $status
            Details   = $details
        }
    }

    $wbSource.Close($false)

    # --- Создание нового Excel файла ---
    Write-Host "Создание нового файла $TargetExcelPath..." -ForegroundColor Cyan
    $wbTarget = $excel.Workbooks.Add()
    $wsTarget = $wbTarget.Worksheets.Item(1)

    # Заголовки
    $wsTarget.Cells.Item(1, 1).Value2 = "Имя группы"
    $wsTarget.Cells.Item(1, 2).Value2 = "Статус"
    $wsTarget.Cells.Item(1, 3).Value2 = "Точное расположение / Описание"
    
    $wsTarget.Range("A1:C1").Font.Bold = $true

    # Запись данных
    $rowTarget = 2
    foreach ($item in $results) {
        $wsTarget.Cells.Item($rowTarget, 1).Value2 = $item.GroupName
        $wsTarget.Cells.Item($rowTarget, 2).Value2 = $item.Status
        $wsTarget.Cells.Item($rowTarget, 3).Value2 = $item.Details
        $rowTarget++
    }

    # Автоподбор ширины столбцов
    [void]$wsTarget.Columns.AutoFit()

    if (Test-Path $TargetExcelPath) { Remove-Item $TargetExcelPath -Force }
    $wbTarget.SaveAs($TargetExcelPath)
    $wbTarget.Close($true)

    Write-Host "Готово! Результат сохранен в: $TargetExcelPath" -ForegroundColor Green
}
catch {
    Write-Error "Произошла ошибка: $_"
}
finally {
    if ($null -ne $excel) {
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.GC]::Collect()
        [System.GC]::WaitForPendingFinalizers()
    }
}
