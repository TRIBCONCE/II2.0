Import-Module ActiveDirectory

# Укажи полный путь к новому файлу
$FilePath = "C:\Путь\К\Файлу\Новый_файл.xlsx"

# Запускаем Excel в фоновом режиме
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    Write-Host "Открываем файл $FilePath..." -ForegroundColor Cyan
    $wb = $excel.Workbooks.Open($FilePath)
    
    # Обращаемся к листу Sheet1
    $ws = $wb.Sheets.Item("Sheet1") 
    
    $lastRow = $ws.UsedRange.Rows.Count
    
    # Ищем, в каком по счету столбце находится заголовок "user_email"
    $emailCol = 0
    $lastCol = $ws.UsedRange.Columns.Count
    for ($c = 1; $c -le $lastCol; $c++) {
        if ($ws.Cells.Item(1, $c).Text -eq "user_email") {
            $emailCol = $c
            break
        }
    }
    
    if ($emailCol -eq 0) {
        Write-Host "[!] Столбец 'user_email' не найден в первой строке! Скрипт остановлен." -ForegroundColor Red
        return
    }
    
    # Ставим заголовок в столбец J (10-й столбец)
    $ws.Cells.Item(1, 10).Value2 = "Статус в AD"

    Write-Host "Начинаем проверку почт в AD..." -ForegroundColor Cyan

    for ($row = 2; $row -le $lastRow; $row++) {
        $email = $ws.Cells.Item($row, $emailCol).Text.Trim()
        
        # Пропускаем пустые ячейки
        if ([string]::IsNullOrWhiteSpace($email)) {
            continue
        }
        
        # Ищем пользователя по почте
        $adUser = Get-ADUser -Filter "mail -eq '$email'" -Properties Enabled -ErrorAction SilentlyContinue | Select-Object -First 1
        
        if ($null -ne $adUser) {
            if ($adUser.Enabled) {
                $status = "активный"
            } else {
                $status = "не активен"
            }
        } else {
            $status = "не найден"
        }
        
        # Записываем результат в столбец J (10)
        $ws.Cells.Item($row, 10).Value2 = $status
        
        # Вывод прогресса в консоль
        Write-Host "Строка $row: $email -> $status"
    }

    # Сохраняем изменения
    $wb.Save()
    Write-Host "`n[+] Готово! Статусы успешно записаны в столбец J." -ForegroundColor Green
}
catch {
    Write-Host "[!] Произошла ошибка: $_" -ForegroundColor Red
}
finally {
    # Корректно закрываем процесс Excel
    if ($null -ne $wb) { $wb.Close($false) }
    $excel.Quit()
    [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
    [System.GC]::Collect()
    [System.GC]::WaitForPendingFinalizers()
}
