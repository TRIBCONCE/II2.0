# ==============================================================================
# НАСТРОЙКИ ПУТЕЙ
# ==============================================================================
$SourceExcelPath = "C:\Temp\SourceGroups.xlsx" # Путь к исходному файлу
$TargetExcelPath = "C:\Temp\FoundGroups.xlsx"  # Путь для нового файла

# ==============================================================================
# ФУНКЦИЯ ДЛЯ ПОИСКА В ШИРИНУ (BFS)
# ==============================================================================
function Get-FolderWithGroupBFS {
    param (
        [string]$BasePath,
        [string]$GroupName
    )

    # Используем очередь для поиска в ширину (уровень за уровнем)
    $queue = [System.Collections.Generic.Queue[string]]::new()
    $queue.Enqueue($BasePath)

    while ($queue.Count -gt 0) {
        $currentPath = $queue.Dequeue()

        try {
            # Получаем ACL текущей папки
            $acl = Get-Acl -LiteralPath $currentPath -ErrorAction Stop
            
            # Проверяем, есть ли нужная группа в правах.
            # Знак $ в конце означает конец строки, чтобы избежать частичных совпадений
            $hasGroup = $acl.Access | Where-Object { $_.IdentityReference.Value -match "\\$GroupName$" }

            if ($hasGroup) {
                # Группа найдена! Возвращаем путь и прерываем поиск в этой ветке.
                return $currentPath
            }

            # Если группы нет, собираем все подпапки ТОЛЬКО ЭТОГО УРОВНЯ и добавляем в очередь
            $subFolders = Get-ChildItem -LiteralPath $currentPath -Directory -ErrorAction SilentlyContinue
            foreach ($folder in $subFolders) {
                $queue.Enqueue($folder.FullName)
            }
        }
        catch {
            # Пропускаем папки, к которым нет доступа (Access Denied)
            Write-Verbose "Нет доступа к папке: $currentPath"
        }
    }

    # Если обошли всё и не нашли
    return $null
}

# ==============================================================================
# ОСНОВНАЯ ЛОГИКА
# ==============================================================================

Write-Host "Запуск Excel..." -ForegroundColor Cyan
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    # 1. Открываем исходный файл
    Write-Host "Чтение исходного файла $SourceExcelPath..." -ForegroundColor Cyan
    $wbSource = $excel.Workbooks.Open($SourceExcelPath)
    $wsSource = $wbSource.Worksheets.Item(1)
    $lastRow = $wsSource.Cells.SpecialCells(11).Row # xlCellTypeLastCell

    # Создаем массив для хранения результатов
    $results = @()

    # Начинаем со 2 строки (пропускаем заголовки)
    for ($i = 2; $i -le $lastRow; $i++) {
        $groupName = $wsSource.Cells.Item($i, 1).Text
        $rawObjectPath = $wsSource.Cells.Item($i, 4).Text # Путь из Object (4 колонка)

        # Пропускаем пустые строки
        if ([string]::IsNullOrWhiteSpace($groupName)) { continue }

        Write-Host "Обработка группы [$i / $lastRow]: $groupName"

        # --- ШАГ 1: Очистка и преобразование пути ---
        
        # Меняем прямые слеши на обратные
        $cleanPath = $rawObjectPath.Replace("/", "\")
        
        # Отбрасываем имя группы из конца пути, если оно там есть
        $escapedGroup = [regex]::Escape($groupName)
        $cleanPath = $cleanPath -replace "\\$escapedGroup\\?$", ""
        
        # Преобразуем R:\ в формат UNC
        if ($cleanPath -match "^R:\\") {
            $cleanPath = $cleanPath -replace "^R:\\", "\\abb-win.akbars.ru\departments\"
        }

        # Если путь в конце содержит слеш, убираем его для красоты (кроме корня диска)
        $cleanPath = $cleanPath.TrimEnd("\")


        # --- ШАГ 2: Проверка пути и поиск ---
        $finalLocation = ""

        if (-not (Test-Path -LiteralPath $cleanPath -PathType Any)) {
            $finalLocation = "Путь не корректен (базовая папка не найдена: $cleanPath)"
            Write-Host "  -> Базовый путь не существует!" -ForegroundColor Red
        }
        else {
            Write-Host "  -> Базовый путь найден, начинаю поиск в ширину..." -ForegroundColor Yellow
            $foundLocation = Get-FolderWithGroupBFS -BasePath $cleanPath -GroupName $groupName

            if ($foundLocation) {
                $finalLocation = $foundLocation
                Write-Host "  -> НАЙДЕНО: $finalLocation" -ForegroundColor Green
            }
            else {
                $finalLocation = "Группа не найдена ни в одной подпапке"
                Write-Host "  -> Группа не найдена" -ForegroundColor DarkYellow
            }
        }

        # Добавляем результат в массив
        $results += [PSCustomObject]@{
            GroupName = $groupName
            Location  = $finalLocation
        }
    }

    $wbSource.Close($false)

    # 2. Создание нового Excel файла
    Write-Host "Создание нового файла $TargetExcelPath..." -ForegroundColor Cyan
    $wbTarget = $excel.Workbooks.Add()
    $wsTarget = $wbTarget.Worksheets.Item(1)

    # Пишем заголовки
    $wsTarget.Cells.Item(1, 1) = "Имя группы"
    $wsTarget.Cells.Item(1, 2) = "Точное расположение"
    $wsTarget.Cells.Item(1, 1).Font.Bold = $true
    $wsTarget.Cells.Item(1, 2).Font.Bold = $true

    # Пишем данные
    $rowTarget = 2
    foreach ($item in $results) {
        $wsTarget.Cells.Item($rowTarget, 1) = $item.GroupName
        $wsTarget.Cells.Item($rowTarget, 2) = $item.Location
        $rowTarget++
    }

    # Автоподбор ширины столбцов
    [void]$wsTarget.Columns.AutoFit()

    # Сохраняем файл
    if (Test-Path $TargetExcelPath) { Remove-Item $TargetExcelPath -Force }
    $wbTarget.SaveAs($TargetExcelPath)
    $wbTarget.Close($true)

    Write-Host "Готово! Результат сохранен в: $TargetExcelPath" -ForegroundColor Green
}
catch {
    Write-Error "Произошла ошибка: $_"
}
finally {
    # Обязательная очистка процессов Excel
    $excel.Quit()
    [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
    [System.GC]::Collect()
    [System.GC]::WaitForPendingFinalizers()
}
