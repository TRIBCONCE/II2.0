cls
Import-Module ActiveDirectory

# ==============================================================================
# НАСТРОЙКИ
# ==============================================================================
$ExcelPath = "C:\Users\z-BorodinES\Desktop\FoundGroups_AppDS.xlsx"

Write-Host "Запуск Excel..." -ForegroundColor Cyan
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    Write-Host "Чтение файла $ExcelPath..." -ForegroundColor Cyan
    $wb = $excel.Workbooks.Open($ExcelPath)
    $ws = $wb.Worksheets.Item(1)
    $lastRow = $ws.Cells.SpecialCells(11).Row 

    Write-Host "Начинаем запись путей в Active Directory..." -ForegroundColor Yellow

    for ($i = 2; $i -le $lastRow; $i++) {
        $groupName = $ws.Cells.Item($i, 1).Text
        $status    = $ws.Cells.Item($i, 2).Text
        $details   = $ws.Cells.Item($i, 3).Text 

        # Пропускаем пустые строки
        if ([string]::IsNullOrWhiteSpace($groupName)) { continue }

        # Ищем внутри текста 3-й колонки UNC-путь (начинается с \\)
        if ($details -match '(\\\\.*)') {
            $cleanPath = $matches[1].Trim()
            
            try {
                # 1. Проверяем, существует ли группа в AD (используем Filter, чтобы избежать ошибок со спецсимволами)
                $adGroup = Get-ADGroup -Filter "Name -eq '$groupName'" -ErrorAction Stop

                if ($null -ne $adGroup) {
                    # 2. Обновляем атрибут info (Notes)
                    # Если хочешь сначала просто посмотреть, как отработает скрипт, не меняя AD,
                    # добавь -WhatIf в конец следующей команды:
                    Set-ADGroup -Identity $adGroup -Replace @{info=$cleanPath}
                    
                    Write-Host "[$i / $lastRow] УСПЕХ: Группе $groupName записан путь $cleanPath" -ForegroundColor Green
                } else {
                    Write-Host "[$i / $lastRow] ОШИБКА: Группа $groupName не найдена в AD" -ForegroundColor Red
                }
            }
            catch {
                Write-Host "[$i / $lastRow] ОШИБКА ЗАПИСИ: Не удалось обновить $groupName ($($_.Exception.Message))" -ForegroundColor Red
            }
        }
        else {
            # Если в колонке "Точное расположение" нет пути (например, написано "Группа не найдена")
            Write-Host "[$i / $lastRow] ПРОПУСК: $groupName (Нет корректного пути)" -ForegroundColor DarkGray
        }
    }
}
catch {
    Write-Error "Произошла глобальная ошибка: $_"
}
finally {
    # Корректно закрываем Excel, чтобы он не завис в диспетчере задач
    if ($wb) { $wb.Close($false) }
    if ($excel) {
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.GC]::Collect()
        [System.GC]::WaitForPendingFinalizers()
    }
    Write-Host "Работа скрипта завершена." -ForegroundColor Cyan
}
