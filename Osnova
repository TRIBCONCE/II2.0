# ==============================================================================
# НАСТРОЙКИ ПУТЕЙ
# ==============================================================================
$SourceExcelPath = "C:\Temp\SourceGroups.xlsx" # Путь к исходному файлу
$TargetExcelPath = "C:\Temp\FoundGroups.xlsx"  # Путь для нового файла

# ==============================================================================
# ФУНКЦИЯ ДЛЯ ПОИСКА В ШИРИНУ (BFS)
# ==============================================================================
function Get-FolderWithGroupBFS {
    param (
        [string]$BasePath,
        [string]$GroupName,
        [int]$MaxDepth = 5,           
        [int]$TimeoutSeconds = 120    
    )

    $startTime = Get-Date
    
    $queue = [System.Collections.Generic.Queue[PSCustomObject]]::new()
    $queue.Enqueue([PSCustomObject]@{ Path = $BasePath; Depth = 0 })

    while ($queue.Count -gt 0) {
        if ((Get-Date) - $startTime -gt [timespan]::FromSeconds($TimeoutSeconds)) {
            return "TIMEOUT" 
        }

        $current = $queue.Dequeue()
        $currentPath = $current.Path
        $currentDepth = $current.Depth

        try {
            $acl = (Get-Item -LiteralPath $currentPath -Force -ErrorAction Stop).GetAccessControl('Access')
            
            $hasGroup = $acl.Access | Where-Object { $_.IdentityReference.Value -match "\\$GroupName$" }

            if ($hasGroup) {
                return $currentPath 
            }

            if ($currentDepth -ge $MaxDepth) {
                continue 
            }

            $subFolders = [System.IO.Directory]::EnumerateDirectories($currentPath)
            foreach ($folder in $subFolders) {
                $queue.Enqueue([PSCustomObject]@{ Path = $folder; Depth = $currentDepth + 1 })
            }
        }
        catch {
            # Пропускаем папки без доступа
        }
    }
    return $null
}

# ==============================================================================
# ОСНОВНАЯ ЛОГИКА
# ==============================================================================

Write-Host "Запуск Excel..." -ForegroundColor Cyan
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    Write-Host "Чтение исходного файла $SourceExcelPath..." -ForegroundColor Cyan
    $wbSource = $excel.Workbooks.Open($SourceExcelPath)
    $wsSource = $wbSource.Worksheets.Item(1)
    $lastRow = $wsSource.Cells.SpecialCells(11).Row 

    $results = @()

    for ($i = 2; $i -le $lastRow; $i++) {
        $groupName = $wsSource.Cells.Item($i, 1).Text
        $rawObjectPath = $wsSource.Cells.Item($i, 4).Text

        if ([string]::IsNullOrWhiteSpace($groupName)) { continue }

        Write-Host "Обработка [$i / $lastRow]: $groupName"

        # --- ШАГ 1: Базовая очистка ---
        $cleanPath = $rawObjectPath.Replace("/", "\")
        $escapedGroup = [regex]::Escape($groupName)
        $cleanPath = $cleanPath -replace "\\$escapedGroup\\?$", ""
        
        # Попытка 1: Формируем стандартный путь (допускаем, что скрытых символов нет)
        $standardPath = $cleanPath
        if ($standardPath -match "^R:\\") {
            $standardPath = $standardPath -replace "^R:\\", "\\abb-win.akbars.ru\departments\"
        }
        $standardPath = $standardPath.TrimEnd("\").Trim()

        $hasHiddenChar = $false
        $finalBasePath = ""

        # --- ШАГ 2: Интеллектуальная проверка пути ---
        if (Test-Path -LiteralPath $standardPath -PathType Any) {
            # Путь рабочий без изменений
            $finalBasePath = $standardPath
        } else {
            # Попытка 2: Ищем в строке начало диска или UNC-пути и отсекаем весь мусор ДО него
            # (?s) позволяет регулярке корректно работать даже если есть переносы строк
            if ($cleanPath -match '(?s)([a-zA-Z]:\\.*|\\\\.*)') {
                $fixedPath = $matches[1]
                
                if ($fixedPath -match "^R:\\") {
                    $fixedPath = $fixedPath -replace "^R:\\", "\\abb-win.akbars.ru\departments\"
                }
                $fixedPath = $fixedPath.TrimEnd("\").Trim()

                # Если очищенный путь отличается и он СУЩЕСТВУЕТ
                if ($fixedPath -ne $standardPath -and (Test-Path -LiteralPath $fixedPath -PathType Any)) {
                    $hasHiddenChar = $true
                    $finalBasePath = $fixedPath
                }
            }
        }

        # --- ШАГ 3: Поиск группы и формирование статусов ---
        $status = ""
        $details = ""

        if (-not $finalBasePath) {
            $status = "Путь не корректен"
            $details = "Путь не корректен(базовая папка не найдена: $standardPath)"
            Write-Host "  -> $status" -ForegroundColor Red
        }
        else {
            if ($hasHiddenChar) {
                Write-Host "  -> Найден скрытый символ! Ищу по исправленному пути..." -ForegroundColor Cyan
            } else {
                Write-Host "  -> Базовый путь найден, ищу..." -ForegroundColor Yellow
            }

            # Запускаем BFS поиск по рабочему базовому пути
            $foundLocation = Get-FolderWithGroupBFS -BasePath $finalBasePath -GroupName $groupName
            
            # Определяем, нашли группу или нет
            if ($foundLocation -eq "TIMEOUT") {
                $details = "Превышено время поиска (>120 сек). Требуется ручной поиск."
                $baseStatus = "Группа не найдена"
            }
            elseif ($foundLocation) {
                $details = $foundLocation
                $baseStatus = "Найдено"
            }
            else {
                $details = "Не найдено в пределах 5 уровней вложенности."
                $baseStatus = "Группа не найдена"
            }

            # Итоговый статус (приоритет у скрытого символа)
            if ($hasHiddenChar) {
                $status = "Путь существует необходимо убрать символ в начале"
                $details = "[Скрытый символ] $details"
                Write-Host "  -> НАЙДЕНО (был скрытый символ)" -ForegroundColor Green
            } else {
                $status = $baseStatus
                if ($baseStatus -eq "Найдено") {
                    Write-Host "  -> НАЙДЕНО" -ForegroundColor Green
                } else {
                    Write-Host "  -> $baseStatus" -ForegroundColor DarkYellow
                }
            }
        }

        $results += [PSCustomObject]@{
            GroupName = $groupName
            Status    = $status
            Details   = $details
        }
    }

    $wbSource.Close($false)

    # --- Создание нового Excel файла ---
    Write-Host "Создание нового файла $TargetExcelPath..." -ForegroundColor Cyan
    $wbTarget = $excel.Workbooks.Add()
    $wsTarget = $wbTarget.Worksheets.Item(1)

    $wsTarget.Cells.Item(1, 1) = "Имя группы"
    $wsTarget.Cells.Item(1, 2) = "Статус"
    $wsTarget.Cells.Item(1, 3) = "Точное расположение / Описание"
    
    $wsTarget.Range("A1:C1").Font.Bold = $true

    $rowTarget = 2
    foreach ($item in $results) {
        $wsTarget.Cells.Item($rowTarget, 1) = $item.GroupName
        $wsTarget.Cells.Item($rowTarget, 2) = $item.Status
        $wsTarget.Cells.Item($rowTarget, 3) = $item.Details
        $rowTarget++
    }

    [void]$wsTarget.Columns.AutoFit()

    if (Test-Path $TargetExcelPath) { Remove-Item $TargetExcelPath -Force }
    $wbTarget.SaveAs($TargetExcelPath)
    $wbTarget.Close($true)

    Write-Host "Готово! Результат сохранен в: $TargetExcelPath" -ForegroundColor Green
}
catch {
    Write-Error "Произошла ошибка: $_"
}
finally {
    if ($excel) {
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.GC]::Collect()
        [System.GC]::WaitForPendingFinalizers()
    }
}
