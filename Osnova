cls
Import-Module ActiveDirectory

$OutputFile = "C:\Users\z-BorodinES\Desktop\Отчёт_по_группам_AD.xlsx"

# Точный путь, скопированный из атрибутов AD
$SearchBase = "OU=R: Departments,OU=Department FS Access Groups,OU=Файловые серверы ABCloud,OU=ABCloud,OU=Серверы и ресурсы,OU=Головной офис,DC=abb-win,DC=akbars,DC=ru"

Write-Host "Получение списка групп из конкретной OU..." -ForegroundColor Cyan

# Берем ВСЕ группы из указанной OU, запрашиваем info (Notes) и CanonicalName (Object)
$groups = Get-ADGroup -Filter * -SearchBase $SearchBase -Properties info, CanonicalName

Write-Host "Найдено групп: $($groups.Count). Начинается проверка путей и прав доступа..." -ForegroundColor Cyan

$ResultData = @()

foreach ($group in $groups) {
    $groupName = $group.Name
    $objectPath = $group.CanonicalName
    
    # Очищаем путь от переносов строк и обычных пробелов
    if ($null -ne $group.info) {
        $folderPath = $group.info -replace "[\r\n]", " "
        $folderPath = $folderPath.Trim()
    } else {
        $folderPath = ""
    }

    if ([string]::IsNullOrWhiteSpace($folderPath)) {
        $status = "Путь не указан"
    } 
    else {
        $workingPath = ""
        $hasHiddenChar = $false

        # Ищем начало UNC-пути \\ и забираем всё до конца строки
        if ($folderPath -match '(\\\\.*)') {
            $cleanUNC = $matches[1]
            
            # Если оригинальная строка отличается от чистого пути (есть скрытые спецсимволы в начале)
            if ($folderPath -ne $cleanUNC) {
                $hasHiddenChar = $true
            }
            
            # Проверяем доступность папки по чистому пути
            if (Test-Path -LiteralPath $cleanUNC -ErrorAction SilentlyContinue) {
                $workingPath = $cleanUNC
            } else {
                $status = "Не существует"
            }
        } 
        else {
            # Если в строке вообще нет \\
            $status = "Некорректный формат пути"
        }

        # Если путь существует, проверяем, назначена ли на него группа
        if ($workingPath -ne "") {
            try {
                # Быстро читаем ACL папки
                $acl = (Get-Item -LiteralPath $workingPath -Force -ErrorAction Stop).GetAccessControl('Access')
                
                # Экранируем спецсимволы в имени группы (на всякий случай) и ищем её в правах
                $escapedGroup = [regex]::Escape($groupName)
                $hasGroup = $acl.Access | Where-Object { $_.IdentityReference.Value -match "\\$escapedGroup$" }

                if ($hasGroup) {
                    $status = if ($hasHiddenChar) { "Путь существует необходимо убрать символ в начале" } else { "Существует" }
                } else {
                    $status = if ($hasHiddenChar) { "Путь существует (надо убрать символ), но группа не соответствует пути" } else { "Путь существует но группа не соответствует пути" }
                }
            } 
            catch {
                # Если у тебя (от чьего имени запущен скрипт) нет прав на чтение свойств безопасности этой папки
                $status = if ($hasHiddenChar) { "Путь существует (надо убрать символ), но нет доступа для проверки прав" } else { "Путь существует, но нет доступа для проверки прав" }
            }
            
            # Перезаписываем путь для Excel, чтобы туда попала чистая рабочая версия (без скрытых символов)
            $folderPath = $workingPath
        }
    }

    $ResultData += [PSCustomObject]@{
        GroupName  = $groupName
        Path       = $folderPath
        Status     = $status
        ObjectPath = $objectPath
    }
}

if ($groups.Count -gt 0) {
    Write-Host "Запись данных в Excel..." -ForegroundColor Cyan

    $excel = New-Object -ComObject Excel.Application
    $excel.Visible = $false
    $excel.DisplayAlerts = $false

    try {
        $workbook = $excel.Workbooks.Add()
        $worksheet = $workbook.Sheets.Item(1)

        $worksheet.Cells.Item(1, 1).Value2 = "Имя группы"
        $worksheet.Cells.Item(1, 2).Value2 = "Путь (из Notes)"
        $worksheet.Cells.Item(1, 3).Value2 = "Статус пути"
        $worksheet.Cells.Item(1, 4).Value2 = "Путь из Object"

        $worksheet.Rows.Item(1).Font.Bold = $true

        $row = 2
        foreach ($item in $ResultData) {
            $worksheet.Cells.Item($row, 1).Value2 = $item.GroupName
            $worksheet.Cells.Item($row, 2).Value2 = $item.Path
            $worksheet.Cells.Item($row, 3).Value2 = $item.Status
            $worksheet.Cells.Item($row, 4).Value2 = $item.ObjectPath
            $row++
        }

        [void]$worksheet.Columns.AutoFit()

        $workbook.SaveAs($OutputFile)
        Write-Host "Файл успешно сохранен: $OutputFile" -ForegroundColor Green
    }
    catch {
        Write-Host "[!] Произошла ошибка при работе с Excel: $_" -ForegroundColor Red
    }
    finally {
        if ($null -ne $workbook) { $workbook.Close($false) }
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.GC]::Collect()
        [System.GC]::WaitForPendingFinalizers()
    }

    Invoke-Item $OutputFile
} else {
    Write-Host "Не найдено ни одной группы в указанной OU. Проверь путь SearchBase." -ForegroundColor Yellow
}
