cls
# ==============================================================================
# НАСТРОЙКИ ПУТЕЙ
# ==============================================================================
$SourceExcelPath = "C:\Users\z-BorodinES\Desktop\FoundGroups.xlsx" # Исходный файл
$TargetExcelPath = "C:\Users\z-BorodinES\Desktop\FoundGroups_AppDS.xlsx" # Куда сохранить результат

# Целевой путь для поиска (можно указать R:\AppDS, но UNC надежнее)
$AppDS_SearchBase = "\\p-fsglo-gl02f.abb-win.akbars.ru\AppDS" 
$MaxDepth = 5

# ==============================================================================
# ФУНКЦИЯ ПОИСКА С КЭШИРОВАНИЕМ ЧЕРЕЗ ROBOCOPY
# ==============================================================================
# Эта переменная будет хранить все папки в памяти, чтобы не дергать диск 100 раз
$global:RoboFolderCache = $null

function Search-GroupInAppDS {
    param (
        [string]$BasePath,
        [string]$GroupName,
        [int]$DepthLimit = 5
    )

    # 1. Если кэш пуст - запускаем Robocopy и собираем структуру ОДИН РАЗ
    if ($null -eq $global:RoboFolderCache) {
        Write-Host "  -> [КЭШ ПУСТ] Запуск Robocopy для быстрого сканирования $BasePath (глубина $DepthLimit)..." -ForegroundColor Magenta
        
        # /L - только листинг (не копировать)
        # /E - все подпапки (включая пустые)
        # /LEV - лимит вложенности
        # /XJ - без junction points (симлинков)
        # /NFL, /NC, /NS, /NJH, /NJT - отключение мусора в выводе лога
        # /NDL НЕ ПИШЕМ - иначе он скроет названия папок!
        $roboArgs = @(
            $BasePath, "NULL", 
            "/L", "/E", "/LEV:$DepthLimit", "/XJ", 
            "/NFL", "/NC", "/NS", "/NJH", "/NJT", "/R:0", "/W:0"
        )
        
        $output = & robocopy $roboArgs
        $global:RoboFolderCache = [System.Collections.Generic.List[string]]::new()
        
        # Парсим вывод и сохраняем чистые пути в список
        foreach ($line in $output) {
            $folderPath = $line.Trim()
            
            # Проверяем, что строка не пустая и это реально папка
            if ($folderPath -and (Test-Path -LiteralPath $folderPath -PathType Container -ErrorAction SilentlyContinue)) {
                $global:RoboFolderCache.Add($folderPath)
            }
        }
        Write-Host "  -> [КЭШ СОЗДАН] Найдено папок для перебора: $($global:RoboFolderCache.Count)" -ForegroundColor Green
    }

    # 2. Ищем группу в закэшированном списке папок
    $escapedGroup = [regex]::Escape($GroupName)

    foreach ($folder in $global:RoboFolderCache) {
        try {
            # Читаем ACL
            $acl = (Get-Acl -LiteralPath $folder -ErrorAction Stop).Access
            
            # Ищем совпадение по IdentityReference
            $hasGroup = $acl | Where-Object { $_.IdentityReference.Value -match "\\$escapedGroup$" }

            if ($hasGroup) {
                # Нашли! Возвращаем путь без лишнего слеша на конце
                return $folder.TrimEnd('\')
            }
        }
        catch {
            # Игнорируем папки, к которым у скрипта нет доступа
        }
    }
    
    # Если обошли весь кэш и не нашли
    return $null 
}

# ==============================================================================
# ОСНОВНАЯ ЛОГИКА
# ==============================================================================

Write-Host "Запуск Excel..." -ForegroundColor Cyan
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    Write-Host "Чтение исходного файла $SourceExcelPath..." -ForegroundColor Cyan
    $wbSource = $excel.Workbooks.Open($SourceExcelPath)
    $wsSource = $wbSource.Worksheets.Item(1)
    $lastRow = $wsSource.Cells.SpecialCells(11).Row 

    $results = @()

    for ($i = 2; $i -le $lastRow; $i++) {
        $groupName = $wsSource.Cells.Item($i, 1).Text
        $status    = $wsSource.Cells.Item($i, 2).Text
        $details   = $wsSource.Cells.Item($i, 3).Text # Точное расположение / Описание

        if ([string]::IsNullOrWhiteSpace($groupName)) { continue }

        Write-Host "Обработка [$i / $lastRow]: $groupName"

        # Проверяем, содержит ли текущий путь триггер "Users-APPsFileExchange"
        if ($details -match "Users-APPsFileExchange") {
            Write-Host "  -> Триггер 'Users-APPsFileExchange' найден. Ищем группу в AppDS..." -ForegroundColor Yellow
            
            $foundAppDS = Search-GroupInAppDS -BasePath $AppDS_SearchBase -GroupName $groupName -DepthLimit $MaxDepth

            if ($foundAppDS) {
                $status  = "Найдено (AppDS)"
                $details = $foundAppDS
                Write-Host "  -> НАЙДЕНО: $details" -ForegroundColor Green
            } else {
                $status  = "Группа не найдена (AppDS)"
                $details = "Не найдено в пределах $MaxDepth уровней в $AppDS_SearchBase"
                Write-Host "  -> Не найдено" -ForegroundColor DarkYellow
            }
        }
        else {
            # Если это обычная группа, ничего не меняем, просто пишем в лог, что пропускаем
            Write-Host "  -> Обычная группа, переносим без изменений." -ForegroundColor Gray
        }

        # Собираем строку для нового файла
        $results += [PSCustomObject]@{
            GroupName = $groupName
            Status    = $status
            Details   = $details
        }
    }

    $wbSource.Close($false)

    # --- Создание нового Excel файла ---
    Write-Host "Создание нового файла $TargetExcelPath..." -ForegroundColor Cyan
    $wbTarget = $excel.Workbooks.Add()
    $wsTarget = $wbTarget.Worksheets.Item(1)

    $wsTarget.Cells.Item(1, 1).Value2 = "Имя группы"
    $wsTarget.Cells.Item(1, 2).Value2 = "Статус"
    $wsTarget.Cells.Item(1, 3).Value2 = "Точное расположение / Описание"
    
    $wsTarget.Range("A1:C1").Font.Bold = $true

    $rowTarget = 2
    foreach ($item in $results) {
        $wsTarget.Cells.Item($rowTarget, 1).Value2 = $item.GroupName
        $wsTarget.Cells.Item($rowTarget, 2).Value2 = $item.Status
        $wsTarget.Cells.Item($rowTarget, 3).Value2 = $item.Details
        $rowTarget++
    }

    [void]$wsTarget.Columns.AutoFit()

    if (Test-Path $TargetExcelPath) { Remove-Item $TargetExcelPath -Force }
    $wbTarget.SaveAs($TargetExcelPath)
    $wbTarget.Close($true)

    Write-Host "Готово! Результат сохранен в: $TargetExcelPath" -ForegroundColor Green
}
catch {
    Write-Error "Произошла ошибка: $_"
}
finally {
    if ($excel) {
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.GC]::Collect()
        [System.GC]::WaitForPendingFinalizers()
    }
}
