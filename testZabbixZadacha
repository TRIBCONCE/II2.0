# ==============================================================================
# ОБНОВЛЕННАЯ ФУНКЦИЯ ПОИСКА С ГИБКИМ СРАВНЕНИЕМ ИМЕН
# ==============================================================================
function Search-GroupInAppDS {
    param (
        [string]$BasePath,
        [string]$GroupName,
        [int]$DepthLimit = 5
    )

    # 1. Если кэш пуст - запускаем Robocopy
    if ($null -eq $global:RoboFolderCache) {
        Write-Host "  -> [КЭШ ПУСТ] Запуск Robocopy для быстрого сканирования $BasePath (глубина $DepthLimit)..." -ForegroundColor Magenta
        
        $roboArgs = @(
            $BasePath, "NULL", 
            "/L", "/E", "/LEV:$DepthLimit", "/XJ", 
            "/NFL", "/NC", "/NS", "/NJH", "/NJT", "/R:0", "/W:0"
        )
        
        $output = & robocopy $roboArgs
        $global:RoboFolderCache = [System.Collections.Generic.List[string]]::new()
        
        foreach ($line in $output) {
            $folderPath = $line.Trim()
            if ($folderPath -and (Test-Path -LiteralPath $folderPath -PathType Container -ErrorAction SilentlyContinue)) {
                $global:RoboFolderCache.Add($folderPath)
            }
        }
        Write-Host "  -> [КЭШ СОЗДАН] Найдено папок для перебора: $($global:RoboFolderCache.Count)" -ForegroundColor Green
    }

    # 2. Ищем группу в закэшированном списке папок (ГИБКИЙ ПОИСК)
    $cleanGroup = $GroupName.Trim()
    $escapedGroup = [regex]::Escape($cleanGroup)

    foreach ($folder in $global:RoboFolderCache) {
        try {
            $acl = (Get-Acl -LiteralPath $folder -ErrorAction Stop).Access
            
            $hasGroup = $acl | Where-Object { 
                $aclFullRef = $_.IdentityReference.Value # Пример: ABB-WIN\DACL_Group_Name
                
                # Отсекаем домен (все, что до слеша включительно), оставляем чистое имя из ACL
                $aclCleanName = $aclFullRef -replace "^.*\\", ""
                
                # Проверяем два условия "похожести":
                # 1. Имя из Excel содержится в имени из ACL (сработает для полного совпадения)
                # 2. Имя из ACL содержится в имени из Excel (сработает, если в ACL имя обрезано)
                ($aclFullRef -match $escapedGroup) -or ($cleanGroup -match [regex]::Escape($aclCleanName))
            }

            if ($hasGroup) {
                return $folder.TrimEnd('\')
            }
        }
        catch {
            # Игнорируем папки, к которым нет доступа
        }
    }
    
    return $null 
}
