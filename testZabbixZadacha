# ==============================================================================
# ФУНКЦИЯ ПОИСКА С КЭШИРОВАНИЕМ (С ИСПРАВЛЕННОЙ КОДИРОВКОЙ)
# ==============================================================================
function Search-GroupInAppDS {
    param (
        [string]$BasePath,
        [string]$GroupName,
        [int]$DepthLimit = 5
    )

    # 1. Заполняем кэш, если он пуст
    if ($null -eq $global:RoboFolderCache) {
        Write-Host "  -> [КЭШ ПУСТ] Запуск Robocopy для быстрого сканирования $BasePath (глубина $DepthLimit)..." -ForegroundColor Magenta
        
        # Генерируем путь к временному файлу лога
        $tempLog = Join-Path $env:TEMP "robo_cache_$([guid]::NewGuid().Guid).log"
        
        $roboArgs = @(
            $BasePath, "NULL", 
            "/L", "/E", "/LEV:$DepthLimit", "/XJ", 
            "/NFL", "/NC", "/NS", "/NJH", "/NJT", "/R:0", "/W:0",
            "/UNILOG:$tempLog" # Вывод в лог в кодировке Unicode (решает проблему русских букв!)
        )
        
        # Запускаем robocopy. Вывода в консоль не будет, всё уйдет в файл
        & robocopy $roboArgs | Out-Null
        
        $global:RoboFolderCache = [System.Collections.Generic.List[string]]::new()
        
        # Если лог создался, читаем из него папки
        if (Test-Path -LiteralPath $tempLog) {
            $lines = Get-Content -LiteralPath $tempLog
            foreach ($line in $lines) {
                # Ищем UNC-путь или букву диска в строке лога
                if ($line -match '([a-zA-Z]:\\.*|\\\\.*)') {
                    $folderPath = $matches[1].Trim()
                    
                    if (Test-Path -LiteralPath $folderPath -PathType Container -ErrorAction SilentlyContinue) {
                        $global:RoboFolderCache.Add($folderPath)
                    }
                }
            }
            # Удаляем временный файл за собой
            Remove-Item -LiteralPath $tempLog -Force
        }
        
        Write-Host "  -> [КЭШ СОЗДАН] Успешно загружено папок в память: $($global:RoboFolderCache.Count)" -ForegroundColor Green
        
        if ($global:RoboFolderCache.Count -eq 0) {
            Write-Host "  -> [ВНИМАНИЕ] Кэш пуст! Проверь, существует ли базовый путь и есть ли к нему доступ." -ForegroundColor Red
        }
    }

    # 2. Ищем группу в закэшированном списке папок
    $cleanGroup = $GroupName.Trim()

    foreach ($folder in $global:RoboFolderCache) {
        try {
            $acl = (Get-Acl -LiteralPath $folder -ErrorAction Stop).Access
            
            foreach ($rule in $acl) {
                # Получаем имя без домена
                $aclCleanName = $rule.IdentityReference.Value.Split('\')[-1].Trim()
                
                if ($aclCleanName -eq $cleanGroup) {
                    return $folder.TrimEnd('\')
                }
            }
        }
        catch {
            # Пропускаем закрытые папки
        }
    }
    
    return $null 
}
