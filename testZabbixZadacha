# ==============================================================================
# ИСПРАВЛЕННАЯ ФУНКЦИЯ ПОИСКА С КЭШИРОВАНИЕМ
# ==============================================================================
function Search-GroupInAppDS {
    param (
        [string]$BasePath,
        [string]$GroupName,
        [int]$DepthLimit = 5
    )

    # 1. Заполняем кэш, если он пуст
    if ($null -eq $global:RoboFolderCache) {
        Write-Host "  -> [КЭШ ПУСТ] Запуск Robocopy для быстрого сканирования $BasePath (глубина $DepthLimit)..." -ForegroundColor Magenta
        
        $roboArgs = @(
            $BasePath, "NULL", 
            "/L", "/E", "/LEV:$DepthLimit", "/XJ", 
            "/NFL", "/NC", "/NS", "/NJH", "/NJT", "/R:0", "/W:0"
        )
        
        $output = & robocopy $roboArgs
        $global:RoboFolderCache = [System.Collections.Generic.List[string]]::new()
        
        foreach ($line in $output) {
            # ИЗМЕНЕНИЕ 1: Регулярка ищет начало пути (буква диска:\ или \\) и забирает только его, отбрасывая счетчики Robocopy
            if ($line -match '([a-zA-Z]:\\.*|\\\\.*)') {
                $folderPath = $matches[1].Trim()
                
                if (Test-Path -LiteralPath $folderPath -PathType Container -ErrorAction SilentlyContinue) {
                    $global:RoboFolderCache.Add($folderPath)
                }
            }
        }
        Write-Host "  -> [КЭШ СОЗДАН] Успешно загружено папок в память: $($global:RoboFolderCache.Count)" -ForegroundColor Green
    }

    # 2. Ищем группу в закэшированном списке папок
    $cleanGroup = $GroupName.Trim()

    foreach ($folder in $global:RoboFolderCache) {
        try {
            $acl = (Get-Acl -LiteralPath $folder -ErrorAction Stop).Access
            
            foreach ($rule in $acl) {
                # Получаем полное имя (например, ABB-WIN\ОФ Внутренний учет - write)
                $aclFullRef = $rule.IdentityReference.Value
                
                # ИЗМЕНЕНИЕ 2: Просто разбиваем строку по слешу и берем последний элемент
                $aclCleanName = $aclFullRef.Split('\')[-1].Trim()
                
                # Оператор -eq в PowerShell работает без учета регистра (case-insensitive)
                if ($aclCleanName -eq $cleanGroup) {
                    return $folder.TrimEnd('\')
                }
            }
        }
        catch {
            # Пропускаем папки, к которым у скрипта нет доступа
        }
    }
    
    return $null 
}
