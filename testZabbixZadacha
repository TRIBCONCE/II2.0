# ===================== ЗАГРУЗКА ДАННЫХ ИЗ SQL БД =====================
Write-Host "Подключение к базе данных SQL и загрузка данных..." -ForegroundColor Cyan

$dbDict = @{}       # Словарь уволенных (ФИО -> Дата увольнения)
$vacationDict = @{} # Словарь отпусков (ФИО -> Строка с датами отпуска)

$connectionString = "Server=$SqlServer;Database=$SqlDb;User ID=$SqlUser;Password=$SqlPass;"

try {
    $connection = New-Object System.Data.SqlClient.SqlConnection($connectionString)
    $connection.Open()

    # --- ЗАПРОС 1: Сбор данных об увольнениях ---
    $queryUv = "SELECT LastName, FirstName, MiddleName, UvDate FROM v_Empl_info WHERE LastName IS NOT NULL"
    $commandUv = New-Object System.Data.SqlClient.SqlCommand($queryUv, $connection)
    $readerUv = $commandUv.ExecuteReader()

    while ($readerUv.Read()) {
        $ln = $readerUv["LastName"].ToString().Trim()
        $fn = $readerUv["FirstName"].ToString().Trim()
        $mn = $readerUv["MiddleName"].ToString().Trim()
        $uvDate = $readerUv["UvDate"].ToString().Trim()
        
        $fullFio = "$ln $fn $mn".Trim() -replace '\s+', ' '
        
        if (-not [string]::IsNullOrWhiteSpace($fullFio)) {
            $dbDict[$fullFio.ToLower()] = $uvDate
        }
    }
    $readerUv.Close()
    Write-Host "Данные об увольнениях загружены." -ForegroundColor Green

    # --- ЗАПРОС 2: Сбор данных об отпусках на текущий день ---
    # CONVERT(varchar, ..., 104) отформатирует дату как ДД.ММ.ГГГГ прямо на стороне SQL
    $queryVacation = @"
        SELECT e.LastName, e.FirstName, e.MiddleName, 
               CONVERT(varchar, f.StartDate, 104) AS StartDateStr, 
               CONVERT(varchar, f.EndDate, 104) AS EndDateStr
        FROM IC.Furlough_WT f
        JOIN IC.Empl_WT_USPS e ON e.EmplID=f.EmplID
        WHERE e.UvDate IS NULL
          AND f.StartDate <= CAST(GETDATE() AS date)
          AND f.EndDate >= CAST(GETDATE() AS date)
"@
    $commandVac = New-Object System.Data.SqlClient.SqlCommand($queryVacation, $connection)
    $readerVac = $commandVac.ExecuteReader()

    while ($readerVac.Read()) {
        $ln = $readerVac["LastName"].ToString().Trim()
        $fn = $readerVac["FirstName"].ToString().Trim()
        $mn = $readerVac["MiddleName"].ToString().Trim()
        $sDate = $readerVac["StartDateStr"].ToString().Trim()
        $eDate = $readerVac["EndDateStr"].ToString().Trim()
        
        $fullFio = "$ln $fn $mn".Trim() -replace '\s+', ' '
        
        if (-not [string]::IsNullOrWhiteSpace($fullFio)) {
            $vacationDict[$fullFio.ToLower()] = "в отпуске с $sDate по $eDate"
        }
    }
    $readerVac.Close()
    Write-Host "Данные об отпусках загружены." -ForegroundColor Green

    $connection.Close()
} catch {
    Write-Host "Ошибка подключения или чтения БД: $($_.Exception.Message)" -ForegroundColor Red
    exit
}

# ===================== АНАЛИЗ ПОЛЬЗОВАТЕЛЕЙ =====================
Write-Host "Сверка пользователей AD с базами 1С..." -ForegroundColor Cyan
$rawLines = Get-Content -Path $usersListPath | Where-Object { $_.Trim() -ne "" }

$firedUsers = @()
$activeUsers = @()
$errors = @()

foreach ($line in $rawLines) {
    # 1. Очищаем строку от начального дефиса и пробелов
    $cleanLine = $line -replace '^\s*-\s*', ''

    # 2. Извлекаем логин
    if ($cleanLine -match '^([^\s]+)\s*[-—]\s*(.+)$') {
        $login = $matches[1].Trim()
    } else {
        $login = $cleanLine.Trim()
    }
    
    try {
        # Запрашиваем ФИО в AD
        $adUser = Get-ADUser -Identity $login -Properties DisplayName -ErrorAction Stop
        $adFio = $adUser.DisplayName

        if ([string]::IsNullOrWhiteSpace($adFio)) {
            $errors += "$login (В AD не заполнено поле DisplayName)"
            continue
        }

        # Ищем ФИО в словарях 1С
        $searchFio = $adFio.Trim().ToLower() -replace '\s+', ' '
        
        # Сначала проверяем увольнение
        if ($dbDict.ContainsKey($searchFio)) {
            $uvDate = $dbDict[$searchFio]
            
            if (-not [string]::IsNullOrWhiteSpace($uvDate)) {
                # Пользователь уволен
                $firedUsers += "$login — $adFio (уволен с $uvDate)"
            } else {
                # Пользователь НЕ уволен -> проверяем отпуск
                if ($vacationDict.ContainsKey($searchFio)) {
                    $vacInfo = $vacationDict[$searchFio]
                    $activeUsers += "$login — $adFio ($vacInfo)"
                } else {
                    $activeUsers += "$login — $adFio"
                }
            }
        } else {
            $errors += "$login — $adFio (ФИО не найдено в базе 1С)"
        }

    } catch {
        $errors += "$line (Логин '$login' не найден в AD)"
    }
}

# ===================== ФОРМИРОВАНИЕ ОТЧЕТА =====================
$firedCount = $firedUsers.Count
$activeCount = $activeUsers.Count

$firedListString = if ($firedCount -gt 0) { $firedUsers -join "`r`n" } else { "Нет уволенных" }
$activeListString = if ($activeCount -gt 0) { $activeUsers -join "`r`n" } else { "Нет неуволенных" }

$reportMessage = @"
Уволенные($firedCount):
$firedListString

Не уволенные($activeCount):
$activeListString
"@

if ($errors.Count -gt 0) {
    $reportMessage += "`r`n`r`nОШИБКИ ПОИСКА (несовпадение ФИО или отсутствие в AD):`r`n" + ($errors -join "`r`n")
}

Set-Content -Path $reportPath -Value $reportMessage -Encoding UTF8
Write-Host "`nГотово! Отчет сохранен: $reportPath" -ForegroundColor Green
