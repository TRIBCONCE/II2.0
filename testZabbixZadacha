# ===================== НАСТРОЙКИ =====================
Import-Module ActiveDirectory

$usersListPath = "C:\Users\z-BorodinES\Desktop\Polz.txt"      # Путь к текстовому файлу со списком (Логин — ФИО)
$reportPath    = "C:\Users\z-BorodinES\Desktop\Otchet.txt"    # Куда сохранить итоговый отчет

# Настройки подключения к БД
$SqlServer = "p-knot-db01.abb-win.akbars.ru"
$SqlDb     = "DWDATA_ODS"
$SqlUser   = "syncad"
$SqlPass   = "скрыл" # Замените на реальный пароль перед запуском

# ===================== ЗАГРУЗКА ДАННЫХ ИЗ SQL БД =====================
Write-Host "Подключение к базе данных SQL..." -ForegroundColor Cyan

$1cDict = @{}
$connectionString = "Server=$SqlServer;Database=$SqlDb;User ID=$SqlUser;Password=$SqlPass;"
$query = "SELECT email, UvDate FROM v_Empl_info WHERE email IS NOT NULL"

try {
    # Открываем соединение и выполняем запрос
    $connection = New-Object System.Data.SqlClient.SqlConnection($connectionString)
    $connection.Open()

    $command = New-Object System.Data.SqlClient.SqlCommand($query, $connection)
    $reader = $command.ExecuteReader()

    # Считываем данные и формируем быстрый словарь
    while ($reader.Read()) {
        $email = $reader["email"].ToString().Trim().ToLower()
        $uvDate = $reader["UvDate"].ToString().Trim()
        
        if (-not [string]::IsNullOrWhiteSpace($email)) {
            $1cDict[$email] = $uvDate
        }
    }
    
    $reader.Close()
    $connection.Close()
    Write-Host "Данные из БД успешно загружены!" -ForegroundColor Green
} catch {
    Write-Host "Ошибка подключения или чтения БД: $($_.Exception.Message)" -ForegroundColor Red
    exit # Прерываем скрипт, если база недоступна
}

# ===================== АНАЛИЗ ПОЛЬЗОВАТЕЛЕЙ =====================
Write-Host "Чтение файла пользователей и поиск в AD/БД..." -ForegroundColor Cyan
$rawLines = Get-Content -Path $usersListPath | Where-Object { $_.Trim() -ne "" }

$firedUsers = @()
$activeUsers = @()
$errors = @()

foreach ($line in $rawLines) {
    # Извлекаем логин и ФИО (разделитель — тире или дефис)
    if ($line -match '^(.+?)\s*[-—]\s*(.+)$') {
        $login = $matches[1].Trim()
        $fio   = $matches[2].Trim()
    } else {
        $login = $line.Trim()
        $fio   = ""
    }
    
    try {
        # 1. Запрашиваем email из AD по логину
        $adUser = Get-ADUser -Identity $login -Properties mail -ErrorAction Stop
        $email = $adUser.mail

        if ([string]::IsNullOrWhiteSpace($email)) {
            $errors += "$login — $fio (В AD не указан Email)"
            continue
        }

        # 2. Ищем пользователя в словаре, загруженном из SQL
        $searchEmail = $email.Trim().ToLower()
        
        if ($1cDict.ContainsKey($searchEmail)) {
            $uvDate = $1cDict[$searchEmail]
            
            # 3. Проверяем наличие даты увольнения (UvDate)
            if (-not [string]::IsNullOrWhiteSpace($uvDate)) {
                # UvDate заполнен -> уволен
                $firedUsers += "$login — $fio (с $uvDate)"
            } else {
                # UvDate пустой -> работает (не уволен)
                $activeUsers += "$login — $fio"
            }
        } else {
            $errors += "$login — $fio (Email '$email' не найден в представлении v_Empl_info)"
        }

    } catch {
        $errors += "$login — $fio (Логин не найден в AD)"
    }
}

# ===================== ФОРМИРОВАНИЕ ОТЧЕТА =====================
$firedCount = $firedUsers.Count
$activeCount = $activeUsers.Count

$firedListString = if ($firedCount -gt 0) { $firedUsers -join "`r`n" } else { "Нет уволенных" }
$activeListString = if ($activeCount -gt 0) { $activeUsers -join "`r`n" } else { "Нет неуволенных" }

# Формируем текст строго по вашему шаблону
$reportMessage = @"
Уволенные($firedCount):
$firedListString

Не уволенные($activeCount):
$activeListString
"@

# Добавляем блок с ошибками в конец файла (если кто-то не найден в AD или БД)
if ($errors.Count -gt 0) {
    $reportMessage += "`r`n`r`nОШИБКИ ПОИСКА:`r`n" + ($errors -join "`r`n")
}

# Сохраняем в файл
Set-Content -Path $reportPath -Value $reportMessage -Encoding UTF8
Write-Host "`nГотово! Отчет сохранен: $reportPath" -ForegroundColor Green
