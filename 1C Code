# ==============================================================================
# ШАГ 4: ГЕНЕРАЦИЯ / ОБНОВЛЕНИЕ ЛИСТА "ДИСК R" В EXCEL
# ==============================================================================
Write-Host "`n3. Сохранение данных в Excel (лист 'Диск R')..." -ForegroundColor Cyan

$finalData = Import-Csv -Path $TempCsvPath -Delimiter ";" -Encoding UTF8

$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    $wb = $null
    $ws = $null

    # 1. Если файл уже существует — открываем его, а НЕ создаем с нуля
    if (Test-Path $TargetExcelPath) {
        $wb = $excel.Workbooks.Open($TargetExcelPath)
        
        # Ищем лист "Диск R" среди существующих
        for ($i = 1; $i -le $wb.Worksheets.Count; $i++) {
            if ($wb.Worksheets.Item($i).Name -eq "Диск R") {
                $ws = $wb.Worksheets.Item($i)
                break
            }
        }
        
        # Если такого листа нет — добавляем его первым
        if ($null -eq $ws) {
            $ws = $wb.Worksheets.Add($wb.Worksheets.Item(1))
            $ws.Name = "Диск R"
        } else {
            # Очищаем только этот лист от старых данных перед перезаписью
            $ws.Cells.Clear()
        }
    } else {
        # Если файла нет вообще — создаем новую книгу
        $wb = $excel.Workbooks.Add()
        $ws = $wb.Worksheets.Item(1)
        $ws.Name = "Диск R"
    }

    # 2. Заголовки таблицы
    $ws.Cells.Item(1, 1).Value2 = "Блок бизнеса"
    $ws.Cells.Item(1, 2).Value2 = "Имя группы"
    $ws.Cells.Item(1, 3).Value2 = "Путь(Notes)"
    $ws.Cells.Item(1, 4).Value2 = "TargetPath"
    $ws.Cells.Item(1, 5).Value2 = "Общий размер папки, в Gb"
    $ws.Cells.Item(1, 6).Value2 = "Файлы старше 3х лет, в Gb"
    $ws.Cells.Item(1, 7).Value2 = "Файлы старше 5 лет, в Gb"
    $ws.Range("A1:G1").Font.Bold = $true

    # 3. Заполнение строк
    $row = 2
    foreach ($item in $finalData) {
        $ws.Cells.Item($row, 1).Value2 = "$($item.BusinessBlock)"
        $ws.Cells.Item($row, 2).Value2 = "$($item.GroupName)"
        $ws.Cells.Item($row, 3).Value2 = "$($item.NotesPath)"
        $ws.Cells.Item($row, 4).Value2 = "$($item.TargetPath)"
        $ws.Cells.Item($row, 5).Value2 = "$($item.TotalGB)"
        $ws.Cells.Item($row, 6).Value2 = "$($item.Old3YearsGB)"
        $ws.Cells.Item($row, 7).Value2 = "$($item.Old5YearsGB)"
        $row++
    }

    [void]$ws.Columns.AutoFit()

    # 4. Сохраняем без перезаписи и удаления файла
    if (Test-Path $TargetExcelPath) {
        $wb.Save()
    } else {
        $wb.SaveAs($TargetExcelPath)
    }
    $wb.Close($true)

    Write-Host "`nВСЁ ГОТОВО! Лист 'Диск R' успешно обновлен в файле: $TargetExcelPath" -ForegroundColor Green
}
catch {
    Write-Error "Ошибка при сохранении Excel: $_"
}
finally {
    if ($null -ne $excel) {
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.GC]::Collect()
        [System.GC]::WaitForPendingFinalizers()
    }
}
