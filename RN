cls
Import-Module ActiveDirectory

$timestart = Get-Date
$time = Get-Date -Format "dd.MM.yyyy HH:mm"

# ==============================================================================
# НАСТРОЙКИ
# ==============================================================================
$FinalExcelPath = "C:\Users\z-BorodinES\Desktop\Сайзинг RN.xlsx"
$TempCsvPath    = "C:\Users\z-BorodinES\Desktop\ZabbixZadacha\PersonalDisks_AllUsers_Buffer.csv"
$LogPath        = "C:\Users\z-BorodinES\Desktop\ZabbixZadacha\PersonalDisks_AllUsers_LOG.log"
$MaxThreads     = 8  # Увеличиваем потоки для быстрого обхода массива пользователей

$ScriptStatus = "SUCCESS"

function Write-Log {
    param([string]$Message)
    $TimeStamp = Get-Date -Format "dd.MM.yyyy HH:mm:ss"
    Add-Content -Path $LogPath -Value "[$TimeStamp] $Message" -Encoding UTF8
}

try {
    Write-Log "--- ЗАПУСК ПОЛНОГО СБОРА РАЗМЕРА ЛИЧНЫХ ДИСКОВ N (ВСЕ ПОЛЬЗОВАТЕЛИ AD) ---"
    Write-Host "Авторизация и получение ВСЕХ пользователей из AD..." -ForegroundColor Cyan

    $key_path = "\\p-rpait-syn01\c$\Scripts\cyph_keys\aes.key"
    $ab_pwd_path = "\\p-rpait-syn01\c$\Scripts\cyph_keys\pwd_abw.txt"

    $ab_password = Get-Content $ab_pwd_path | ConvertTo-SecureString -Key (Get-Content $key_path)
    $ab_creds = New-Object System.Management.Automation.PSCredential("ABB-WIN\s-ad-expertise", $ab_password)

    # Запрашиваем абсолютно всех пользователей домена без фильтров
    $AllUsersOn = Get-ADUser `
        -Filter * `
        -Credential $ab_creds `
        -Properties division, name, title, department, HomeDirectory

    Write-Host "Всего объектов пользователей в AD получено: $($AllUsersOn.Count)" -ForegroundColor Green
    Write-Log "Всего пользователей получено: $($AllUsersOn.Count)"

    # ==============================================================================
    # ШАГ 1: ОТБОР ПОЛЬЗОВАТЕЛЕЙ С ЗАПОЛНЕННЫМ ДИСКОМ N
    # ==============================================================================
    $ValidUsers = [System.Collections.Generic.List[PSCustomObject]]::new()

    foreach ($User in $AllUsersOn) {
        $personalPath = $User.HomeDirectory
        
        # Если путь не задан — пропускаем, так как диска N физически нет
        if ([string]::IsNullOrWhiteSpace($personalPath)) {
            continue
        }

        $ValidUsers.Add([PSCustomObject]@{
            Name       = $User.name
            Division   = if ($User.division) { $User.division } else { "(не указано)" }
            Title      = if ($User.title) { $User.title } else { "(не указано)" }
            Department = if ($User.department) { $User.department } else { "(не указано)" }
            Path       = $personalPath.TrimEnd('\')
        })
    }

    Write-Host "Найдено пользователей с назначенным Диском N: $($ValidUsers.Count)" -ForegroundColor Yellow
    Write-Log "Пользователей с HomeDirectory: $($ValidUsers.Count)"

    if ($ValidUsers.Count -eq 0) {
        Write-Host "Нет данных для обработки. Завершение." -ForegroundColor Yellow
        return
    }

    # ==============================================================================
    # ШАГ 2: БУФЕР ПРОГРЕССА (CSV) ДЛЯ НЕУБИВАЕМОСТИ
    # ==============================================================================
    $processedPaths = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)

    if (Test-Path $TempCsvPath) {
        $existing = Import-Csv -Path $TempCsvPath -Delimiter ";" -Encoding UTF8
        foreach ($row in $existing) { [void]$processedPaths.Add($row.UNCPath) }
        Write-Host "Уже посчитано ранее в кэше: $($processedPaths.Count) пользователей." -ForegroundColor Green
    } else {
        "Division;Name;Title;Department;DisplayPath;TotalGB;UNCPath" | Out-File -FilePath $TempCsvPath -Encoding UTF8
    }

    $tasksToRun = $ValidUsers | Where-Object { -not $processedPaths.Contains($_.Path) }
    Write-Host "Осталось обработать: $($tasksToRun.Count) пользователей" -ForegroundColor Cyan

    # ==============================================================================
    # ШАГ 3: МНОГОПОТОЧНЫЙ СБОР РАЗМЕРОВ ЧЕРЕЗ ROBOCOPY
    # ==============================================================================
    if ($tasksToRun.Count -gt 0) {
        Write-Host "`nЗапуск сканирования ($MaxThreads потоков)..." -ForegroundColor Yellow

        $RunspacePool = [runspacefactory]::CreateRunspacePool(1, $MaxThreads)
        $RunspacePool.Open()
        $Jobs = @()

        $ScriptBlock = {
            param($Path, $Name, $Division, $Title, $Department)

            $folderName = Split-Path -Path $Path -Leaf
            $displayPath = "N:\$folderName"

            # Быстрая проверка доступности сетевой папки
            if (-not (Test-Path -LiteralPath $Path -ErrorAction SilentlyContinue)) {
                return [PSCustomObject]@{
                    Division = $Division; Name = $Name; Title = $Title; 
                    Department = $Department; DisplayPath = $displayPath; UNCPath = $Path; TotalGB = 0
                }
            }

            $psi = New-Object System.Diagnostics.ProcessStartInfo
            $psi.FileName = "robocopy.exe"
            $psi.Arguments = "`"$Path`" NUL /L /E /XJ /BYTES /NFL /NDL /NJH /R:0 /W:0 /NP"
            $psi.UseShellExecute = $false
            $psi.CreateNoWindow = $true
            $psi.RedirectStandardOutput = $true
            $psi.StandardOutputEncoding = [System.Text.Encoding]::GetEncoding(866)

            $process = [System.Diagnostics.Process]::Start($psi)

            $stdout = $process.StandardOutput.ReadToEnd()
            $process.WaitForExit(180000) | Out-Null
            if (-not $process.HasExited) { $process.Kill() }
            $process.Dispose()

            [long]$TotalBytes = 0
            foreach ($line in ($stdout -split "`r?`n")) {
                if ($line -match '^\s*Bytes\s*:\s*(\d+)') {
                    $TotalBytes = [long]$matches[1]
                    break
                }
            }

            return [PSCustomObject]@{
                Division    = $Division
                Name        = $Name
                Title       = $Title
                Department  = $Department
                DisplayPath = $displayPath
                UNCPath     = $Path
                TotalGB     = [math]::Round($TotalBytes / 1GB, 2)
            }
        }

        foreach ($u in $tasksToRun) {
            $PowerShell = [powershell]::Create()
            $PowerShell.RunspacePool = $RunspacePool
            [void]$PowerShell.AddScript($ScriptBlock)
            [void]$PowerShell.AddArgument($u.Path)
            [void]$PowerShell.AddArgument($u.Name)
            [void]$PowerShell.AddArgument($u.Division)
            [void]$PowerShell.AddArgument($u.Title)
            [void]$PowerShell.AddArgument($u.Department)
            
            $Jobs += [PSCustomObject]@{
                Pipe    = $PowerShell
                Result  = $PowerShell.BeginInvoke()
                Checked = $false
            }
        }

        $completed = $processedPaths.Count
        $total = $ValidUsers.Count

        while ($Jobs.Result.IsCompleted -contains $false) {
            foreach ($job in $Jobs) {
                if ($job.Result.IsCompleted -and -not $job.Checked) {
                    $job.Checked = $true
                    $completed++
                    
                    try {
                        $res = $job.Pipe.EndInvoke($job.Result)
                        if ($res) {
                            $csvLine = "$($res.Division);$($res.Name);$($res.Title);$($res.Department);$($res.DisplayPath);$($res.TotalGB);$($res.UNCPath)"
                            [System.IO.File]::AppendAllLines($TempCsvPath, [string[]]@($csvLine), [System.Text.Encoding]::UTF8)
                            
                            Write-Host "[$completed / $total] $($res.Name) -> $($res.TotalGB) GB" -ForegroundColor Green
                        }
                    } catch {
                        Write-Host "Ошибка: $($_.Exception.Message)" -ForegroundColor Red
                    }
                }
            }
            Start-Sleep -Milliseconds 150
        }

        # Сбор оставшихся потоков
        foreach ($job in $Jobs) {
            if (-not $job.Checked) {
                $job.Checked = $true
                try {
                    $res = $job.Pipe.EndInvoke($job.Result)
                    if ($res) {
                        $csvLine = "$($res.Division);$($res.Name);$($res.Title);$($res.Department);$($res.DisplayPath);$($res.TotalGB);$($res.UNCPath)"
                        [System.IO.File]::AppendAllLines($TempCsvPath, [string[]]@($csvLine), [System.Text.Encoding]::UTF8)
                        $completed++
                        Write-Host "[$completed / $total] $($res.Name) -> $($res.TotalGB) GB" -ForegroundColor Green
                    }
                } catch { }
            }
            $job.Pipe.Dispose()
        }
        $RunspacePool.Close()
        $RunspacePool.Dispose()
    }

    # ==============================================================================
    # ШАГ 4: СОХРАНЕНИЕ ТОЛЬКО В ЛИСТ "ДИСК N" (НЕ ТРОГАЯ "ДИСК R")
    # ==============================================================================
    Write-Host "`nСохранение в книгу Excel (лист 'Диск N')..." -ForegroundColor Cyan

    $finalData = Import-Csv -Path $TempCsvPath -Delimiter ";" -Encoding UTF8

    $excel = New-Object -ComObject Excel.Application
    $excel.Visible = $false
    $excel.DisplayAlerts = $false

    try {
        $wb = $null
        $ws = $null

        if (Test-Path $FinalExcelPath) {
            $wb = $excel.Workbooks.Open($FinalExcelPath)
            
            # Ищем существующий лист "Диск N"
            for ($i = 1; $i -le $wb.Worksheets.Count; $i++) {
                if ($wb.Worksheets.Item($i).Name -eq "Диск N") {
                    $ws = $wb.Worksheets.Item($i)
                    break
                }
            }
            
            # Если нет — создаем его вторым/следующим листом
            if ($null -eq $ws) {
                $ws = $wb.Worksheets.Add([System.Reflection.Missing]::Value, $wb.Worksheets.Item($wb.Worksheets.Count))
                $ws.Name = "Диск N"
            } else {
                $ws.Cells.Clear()
            }
        } else {
            $wb = $excel.Workbooks.Add()
            $ws = $wb.Worksheets.Item(1)
            $ws.Name = "Диск N"
        }

        # Заголовки таблицы
        $ws.Cells.Item(1, 1).Value2 = "Блок бизнеса"
        $ws.Cells.Item(1, 2).Value2 = "ФИО (AD)"
        $ws.Cells.Item(1, 3).Value2 = "Должность"
        $ws.Cells.Item(1, 4).Value2 = "Департамент"
        $ws.Cells.Item(1, 5).Value2 = "Реальный путь"
        $ws.Cells.Item(1, 6).Value2 = "Диск N, всего в Gb"
        $ws.Range("A1:F1").Font.Bold = $true

        # Заполнение строк
        $row = 2
        foreach ($item in $finalData) {
            $ws.Cells.Item($row, 1).Value2 = "$($item.Division)"
            $ws.Cells.Item($row, 2).Value2 = "$($item.Name)"
            $ws.Cells.Item($row, 3).Value2 = "$($item.Title)"
            $ws.Cells.Item($row, 4).Value2 = "$($item.Department)"
            $ws.Cells.Item($row, 5).Value2 = "$($item.DisplayPath)"
            $ws.Cells.Item($row, 6).Value2 = "$($item.TotalGB)"
            $row++
        }

        [void]$ws.Columns.AutoFit()

        if (Test-Path $FinalExcelPath) {
            $wb.Save()
        } else {
            $wb.SaveAs($FinalExcelPath)
        }
        $wb.Close($true)

        Write-Host "ОТЧЕТ ОБНОВЛЕН: Лист 'Диск N' сохранен в $FinalExcelPath" -ForegroundColor Green
        Write-Log "Успешно обновлен лист 'Диск N' в файле: $FinalExcelPath"
    }
    catch {
        Write-Error "Ошибка Excel: $_"
        Write-Log "Ошибка Excel: $($_.Exception.Message)"
    }
    finally {
        if ($null -ne $excel) {
            $excel.Quit()
            [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
            [System.GC]::Collect()
            [System.GC]::WaitForPendingFinalizers()
        }
    }

    $timestop = Get-Date
    $TimeSum = $timestop - $timestart
    Write-Host "`nВремя выполнения: $($TimeSum.Hours)ч $($TimeSum.Minutes)м $($TimeSum.Seconds)с" -ForegroundColor Cyan
    Write-Log "Полное время выполнения: $($TimeSum.Hours)ч $($TimeSum.Minutes)м $($TimeSum.Seconds)с"
}
catch {
    $ScriptStatus = "ERROR"
    Write-Log "СТАТУС: ERROR. Ошибка: $($_.Exception.Message)"
    Write-Host "`nОШИБКА: $($_.Exception.Message)" -ForegroundColor Red
    throw
}
