function Get-RoboSubFolderSizes {  
param (  
[Parameter(Mandatory = $true)]  
[string]$Path,  
  
[int]$MaxDepth = 5  
)  
  
if ([string]::IsNullOrWhiteSpace($Path) -or !(Test-Path -Path $Path -PathType Container)) {  
Write-Warning "Указанный путь не найден или не является папкой."  
return  
}  
  
# Нормализуем корневой путь и считаем базовое количество уровней вложенности  
$RootPath = (Get-Item $Path).FullName.TrimEnd('\')  
$RootDepth = ($RootPath -split '\\').Count  
  
# Хэш-таблица для быстрого накопления размеров папок в памяти  
$FolderSizes = @{}  
  
# Запускаем robocopy в режиме логирования файлов с размерами  
# /NDL (без папок в выводе) не используем, нам нужен полный лог  
$roboArgs = @(  
"$RootPath", "NULL", "*.*",  
"/L", "/S", "/BYTES", "/XJ",  
"/NFL", "/NJH", "/NJT", "/NC", "/NDL", "/R:0", "/W:0"  
)
результат по настоящим путям будем записывать в xlsx файл с такими же полями Имя группы,	Статус,	Точное расположение / Описание
