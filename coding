# ==============================================================================
# ОБНОВЛЕННАЯ ФУНКЦИЯ (С ЛИМИТАМИ И УСКОРЕНИЕМ .NET)
# ==============================================================================
function Get-FolderWithGroupBFS {
    param (
        [string]$BasePath,
        [string]$GroupName,
        [int]$MaxDepth = 3,           # Искать максимум на 3 уровня вглубь
        [int]$TimeoutSeconds = 45     # Скипать, если ищет дольше 45 секунд
    )

    $startTime = Get-Date
    
    # Очередь теперь хранит объекты (Путь и его Глубина)
    $queue = [System.Collections.Generic.Queue[PSCustomObject]]::new()
    $queue.Enqueue([PSCustomObject]@{ Path = $BasePath; Depth = 0 })

    while ($queue.Count -gt 0) {
        # 1. Проверка таймаута
        if ((Get-Date) - $startTime -gt [timespan]::FromSeconds($TimeoutSeconds)) {
            Write-Host "  -> Превышен лимит времени ($TimeoutSeconds сек). Пропускаем." -ForegroundColor Magenta
            return "Превышено время поиска (>$TimeoutSeconds сек). Требуется ручной поиск."
        }

        $current = $queue.Dequeue()
        $currentPath = $current.Path
        $currentDepth = $current.Depth

        try {
            # 2. Быстрое чтение ACL (запрашиваем только Access, без Owner/Audit)
            $acl = (Get-Item -LiteralPath $currentPath -Force -ErrorAction Stop).GetAccessControl('Access')
            
            $hasGroup = $acl.Access | Where-Object { $_.IdentityReference.Value -match "\\$GroupName$" }

            if ($hasGroup) {
                return $currentPath # Нашли!
            }

            # 3. Проверка глубины. Если достигли дна - не сканируем подпапки
            if ($currentDepth -ge $MaxDepth) {
                continue 
            }

            # 4. Ускоренное получение списка папок через .NET
            $subFolders = [System.IO.Directory]::EnumerateDirectories($currentPath)
            foreach ($folder in $subFolders) {
                $queue.Enqueue([PSCustomObject]@{ Path = $folder; Depth = $currentDepth + 1 })
            }
        }
        catch {
            # Глушим ошибки доступа (Access Denied / слишком длинный путь)
        }
    }

    # Если обошли всё дерево до MaxDepth и ничего не нашли
    return $null
}
