$ScriptBlock = {
        param($Path, $GroupName, $Department)

        # 1. Быстрая проверка доступности ПЕРЕД любыми вызовами
        if (-not (Test-Path -LiteralPath $Path -ErrorAction SilentlyContinue)) {
            return [PSCustomObject]@{
                BusinessBlock = "$Department"
                GroupName     = "$GroupName"
                NotesPath     = "$Path"
                TargetPath    = "НЕДОСТУПЕН"
                TotalGB       = "0"
                Old3YearsGB   = "0"
                Old5YearsGB   = "0"
            }
        }

        # 2. Резолв DFS (только если путь доступен)
        $targetPath = $Path
        try {
            $dfsResult = & dfsutil link $Path 2>$null
            if ($dfsResult -match 'Target:\s+(\\\\.*)') {
                $targetPath = $matches[1].Trim()
            }
        } catch { }

        # 3. Запуск robocopy через изолированный процесс без блокировки консоли
        $psi = New-Object System.Diagnostics.ProcessStartInfo
        $psi.FileName = "robocopy.exe"
        # КРИТИЧНО: /R:0 /W:0 (без зависаний на занятых файлах), /NFL /NDL /NJH (без вывода файлов)
        $psi.Arguments = "`"$Path`" NUL /L /E /XJ /BYTES /NFL /NDL /NJH /R:0 /W:0 /NP"
        $psi.UseShellExecute = $false
        $psi.CreateNoWindow = $true
        $psi.RedirectStandardOutput = $true
        $psi.StandardOutputEncoding = [System.Text.Encoding]::GetEncoding(866)

        $process = [System.Diagnostics.Process]::Start($psi)

        # Читаем только финальную таблицу итогов
        $stdout = $process.StandardOutput.ReadToEnd()
        
        # Таймаут на всякий случай (максимум 3 минуты на папку)
        $finished = $process.WaitForExit(180000)
        if (-not $finished) {
            $process.Kill()
        }
        $process.Dispose()

        [long]$TotalBytes = 0
        foreach ($line in ($stdout -split "`r?`n")) {
            if ($line -match '^\s*Bytes\s*:\s*(\d+)') {
                $TotalBytes = [long]$matches[1]
                break
            }
        }

        return [PSCustomObject]@{
            BusinessBlock = "$Department"
            GroupName     = "$GroupName"
            NotesPath     = "$Path"
            TargetPath    = "$targetPath"
            TotalGB       = "$([math]::Round($TotalBytes / 1GB, 2))"
            Old3YearsGB   = "0"
            Old5YearsGB   = "0"
        }
    }
