cls
Import-Module ActiveDirectory

# ==============================================================================
# НАСТРОЙКИ
# ==============================================================================
$ExcelPath = "C:\Users\z-BorodinES\Desktop\File_BusinessBlock.xlsx" # Укажи свой путь к файлу

Write-Host "Запуск Excel..." -ForegroundColor Cyan
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    Write-Host "Чтение файла $ExcelPath..." -ForegroundColor Cyan
    $wb = $excel.Workbooks.Open($ExcelPath)
    $ws = $wb.Worksheets.Item(1)
    $lastRow = $ws.Cells.SpecialCells(11).Row 

    Write-Host "Начинаем обновление атрибута Department в Active Directory..." -ForegroundColor Yellow

    for ($i = 2; $i -le $lastRow; $i++) {
        $groupName     = $ws.Cells.Item($i, 1).Text
        $businessBlock = $ws.Cells.Item($i, 2).Text

        if ([string]::IsNullOrWhiteSpace($groupName)) { continue }

        $cleanGroup = $groupName.Trim()
        $cleanBlock = $businessBlock.Trim()

        try {
            # Ищем группу в AD (Filter {...} безопаснее обрабатывает спецсимволы в именах)
            $adGroup = Get-ADGroup -Filter {Name -eq $cleanGroup} -ErrorAction Stop

            if ($null -ne $adGroup) {
                if (-not [string]::IsNullOrWhiteSpace($cleanBlock)) {
                    # Записываем значение в атрибут department
                    Set-ADGroup -Identity $adGroup -Replace @{department=$cleanBlock} -ErrorAction Stop
                    Write-Host "[$i / $lastRow] УСПЕХ: Группе '$cleanGroup' записан департамент '$cleanBlock'" -ForegroundColor Green
                } 
                else {
                    # Если ячейка пустая, очищаем атрибут
                    Set-ADGroup -Identity $adGroup -Clear department -ErrorAction Stop
                    Write-Host "[$i / $lastRow] ОЧИЩЕНО: У группы '$cleanGroup' удален атрибут department (пустая ячейка)" -ForegroundColor DarkYellow
                }
            } 
            else {
                Write-Host "[$i / $lastRow] НЕ НАЙДЕНО: Группа '$cleanGroup' не существует в AD" -ForegroundColor Red
            }
        }
        catch {
            Write-Host "[$i / $lastRow] ОШИБКА AD: Не удалось обработать '$cleanGroup' ($($_.Exception.Message))" -ForegroundColor Red
        }
    }
}
catch {
    Write-Error "Произошла глобальная ошибка: $_"
}
finally {
    if ($null -ne $wb) { $wb.Close($false) }
    if ($null -ne $excel) {
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.GC]::Collect()
        [System.GC]::WaitForPendingFinalizers()
    }
    Write-Host "Работа скрипта завершена." -ForegroundColor Cyan
}
