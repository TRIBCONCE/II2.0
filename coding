cls
Write-Host "=== ТЕСТ ROBOCOPY (ПЕРЕХВАТ ВЫВОДА ЧЕРЕЗ POWERSHELL) ===" -ForegroundColor Cyan

$BasePath = "\\p-fsglo-gl02f.abb-win.akbars.ru\AppDS"
$FakeDest = "C:\Users\z-BorodinES\Desktop"
$LogFile  = "C:\Users\z-BorodinES\Desktop\robolog_raw.txt"

Write-Host "1. Запуск Robocopy (без глушителей) и перехват текста в память..." -ForegroundColor Yellow

$roboArgs = @(
    $BasePath, $FakeDest, 
    "/L", "/E", "/LEV:2", "/XJ"
)

# Вызываем robocopy и ВЕСЬ его вывод забираем в переменную $rawOutput
$rawOutput = & robocopy $roboArgs

Write-Host "2. Robocopy отработал. Сохраняю текст в файл..." -ForegroundColor Yellow

# PowerShell сам пишет файл в нормальной кодировке
$rawOutput | Out-File -FilePath $LogFile -Encoding UTF8 -Force

if (Test-Path -LiteralPath $LogFile) {
    $fileSize = (Get-Item $LogFile).Length
    Write-Host "[ОК] Файл сохранен! Размер: $fileSize байт." -ForegroundColor Green
    Write-Host "`nОткрой файл $LogFile на рабочем столе." -ForegroundColor Cyan
    Write-Host "Там обязательно должна быть 'шапка' (заголовок Robocopy). Напиши мне, какие ошибки он там выдал или что вообще написал."
} else {
    Write-Host "[ОШИБКА] Даже PowerShell не смог создать файл лога. Проверь права на рабочий стол." -ForegroundColor Red
}
