# ===================== НАСТРОЙКИ =====================
$excelPath = "C:\Users\z-BorodinES\Desktop\StorUsers.xlsx"
$worksheetName = "UsersStor"
# ===================== БЭКАП =====================
$timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
$backupPath = $excelPath -replace '\.xlsx$', "_backup_$timestamp.xlsx"
Copy-Item $excelPath $backupPath -Force
Write-Host "Резервная копия: $backupPath`n" -ForegroundColor Green
# ===================== AD СВОЙСТВА =====================
$properties = @(
    'DisplayName','SamAccountName','EmployeeID',
    'Enabled','Description'
)
# ===================== ЗАГРУЗКА AD =====================
Write-Host "Загружаем пользователей из AD..." -ForegroundColor Cyan
$allUsers = Get-ADUser -Filter * -Properties $properties
Write-Host "Загружено: $($allUsers.Count) пользователей`n" -ForegroundColor Green
# ===================== ХЕШ-ТАБЛИЦЫ =====================
$usersByLogin = @{}
$usersByFio = @{}
foreach ($u in $allUsers) {
    if ($u.SamAccountName) {
        $usersByLogin[$u.SamAccountName.ToLower()] = $u
    }
    if ($u.DisplayName) {
        $key = $u.DisplayName.ToLower().Trim()
        if (-not $usersByFio.ContainsKey($key)) {
            $usersByFio[$key] = @()
        }
        $usersByFio[$key] += $u
    }
}
# ===================== ФУНКЦИЯ ВЫБОРА =====================
function Select-BestAccount {
    param([array]$Users)
    if (-not $Users) { return $null }
    if ($Users.Count -eq 1) { return $Users[0] }
    $best = $Users | Where-Object { $_.Enabled -and $_.SamAccountName -notlike "z-*" }
    if ($best) { return $best[0] }
    $active = $Users | Where-Object { $_.Enabled }
    if ($active) { return $active[0] }
    return $Users[0]
}
# ===================== EXCEL =====================
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false
$excel.ScreenUpdating = $false
$workbook = $excel.Workbooks.Open($excelPath)
$worksheet = $workbook.Worksheets.Item($worksheetName)
$usedRange = $worksheet.UsedRange
$rowCount = $usedRange.Rows.Count
$colCount = $usedRange.Columns.Count
# ===================== ПОИСК КОЛОНОК =====================
$fioCol = $loginCol = $null
for ($col = 1; $col -le $colCount; $col++) {
    $header = $worksheet.Cells.Item(1, $col).Text.Trim()
    switch ($header) {
        "ФИО"   { $fioCol = $col }
        "Логин" { $loginCol = $col }
    }
}
if (-not $fioCol -and -not $loginCol) {
    throw "Нет столбцов ФИО или Логин!"
}
# ===================== ДОБАВЛЯЕМ СТОЛБЦЫ ПРАВИЛЬНО =====================
# Вставляем 2 новых столбца справа
$lastColLetter = ([char](64 + $colCount))  # A=1, B=2...
$range = $worksheet.Columns.Item($colCount + 1)
$range.Insert()
$range2 = $worksheet.Columns.Item($colCount + 2)
$range2.Insert()
# Обновляем индексы
$disabledCol = $colCount + 1
$descCol     = $colCount + 2
# Заголовки
$worksheet.Cells.Item(1, $disabledCol).Value2 = "Отключена"
$worksheet.Cells.Item(1, $descCol).Value2     = "Увольнение"
# ===================== ОБРАБОТКА =====================
Write-Host "Обработка $($rowCount - 1) строк..." -ForegroundColor Cyan
Write-Host ". = найден | x = не найден | 2 = дубликат`n"
$found = 0
$notFound = 0
$duplicates = 0
for ($row = 2; $row -le $rowCount; $row++) {
    $fio = $worksheet.Cells.Item($row, $fioCol).Text.Trim().ToLower()
    $login = if ($loginCol) { $worksheet.Cells.Item($row, $loginCol).Text.Trim().ToLower() } else { $null }
    $users = @()
    # 1. По логину (приоритет)
    if ($login -and $usersByLogin.ContainsKey($login)) {
        $users = @($usersByLogin[$login])
    }
    # 2. По ФИО
    elseif ($fio -and $usersByFio.ContainsKey($fio)) {
        $users = $usersByFio[$fio]
    }
    if ($users) {
        $isDuplicate = $users.Count -gt 1
        $user = Select-BestAccount $users
        if ($isDuplicate) {
            $duplicates++
            Write-Host "2" -NoNewline -ForegroundColor Magenta
        }
        # ===================== ОТКЛЮЧЕНА ЛИ =====================
        $isDisabled = -not $user.Enabled
        $worksheet.Cells.Item($row, $disabledCol).Value2 = if ($isDisabled) { "Да" } else { "Нет" }
        # ===================== ПРОВЕРКА УВОЛЬНЕНИЯ =====================
        $hasDismiss = $false
        if ($user.Description) {
            if ($user.Description -match "Увольнение") {
                $hasDismiss = $true
            }
        }
        $worksheet.Cells.Item($row, $descCol).Value2 = if ($hasDismiss) { "Да" } else { "Нет" }
        if (-not $isDuplicate) {
            Write-Host "." -NoNewline -ForegroundColor Green
        }
        $found++
    }
    else {
        $worksheet.Cells.Item($row, $disabledCol).Value2 = "Не найден"
        $worksheet.Cells.Item($row, $descCol).Value2     = "Не найден"
        $notFound++
        Write-Host "x" -NoNewline -ForegroundColor Red
    }
}
# ===================== СОХРАНЕНИЕ =====================
Write-Host "`nСохраняем..." -ForegroundColor Yellow
$workbook.Save()
# ===================== СТАТИСТИКА =====================
Write-Host "`n========================================" -ForegroundColor Cyan
Write-Host "Готово!" -ForegroundColor Cyan
Write-Host "Найдено: $found" -ForegroundColor Green
Write-Host "Не найдено: $notFound" -ForegroundColor Red
Write-Host "Дубликаты: $duplicates" -ForegroundColor Magenta
Write-Host "========================================" -ForegroundColor Cyan
# ===================== ЗАКРЫТИЕ =====================
$workbook.Close($true)
$excel.Quit()
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($worksheet) | Out-Null
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($workbook) | Out-Null
