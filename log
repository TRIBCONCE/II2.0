# Запрос только тех, кто в отпуске на текущий день
$qF = @"
SELECT e.LastName, e.FirstName, e.MiddleName, e.Tab_Numb, f.StartDate, f.EndDate
FROM IC.Furlough_WT f
JOIN IC.Empl_WT_USPS e ON e.EmplID=f.EmplID
WHERE e.UvDate IS NULL
  AND f.StartDate <= CAST(GETDATE() AS date)
  AND f.EndDate >= CAST(GETDATE() AS date)
ORDER BY e.LastName
"@
$F = Invoke-Sql $qF 

