# ===================== НАСТРОЙКИ (ТЕСТОВЫЙ СБОР) =====================
$usersListPath = "C:\Path\To\Logins.txt"        # Тот же самый список логинов
$logPath       = "C:\Path\To\PlannedUsers.txt"  # Файл для выгрузки тех, кого нужно оповестить
$targetDate    = [datetime]::ParseExact("04.08.2026", "dd.MM.yyyy", $null)
$maxToChange   = 100

# ===================== ЗАГРУЗКА И ПОИСК =====================
$allLogins = Get-Content -Path $usersListPath | Where-Object { $_.Trim() -ne "" }
$totalCount = $allLogins.Count

Write-Host "[ТЕСТОВЫЙ ПРОГОН] Загружено логинов: $totalCount" -ForegroundColor Cyan
Write-Host "Ищем кандидатов на сброс пароля. В AD ничего не меняется..." -ForegroundColor Yellow

$matchedUsers = @()

foreach ($login in $allLogins) {
    $login = $login.Trim()
    try {
        $user = Get-ADUser -Identity $login -Properties PasswordLastSet, pwdLastSet, DisplayName -ErrorAction Stop
        
        if ($user.pwdLastSet -ne 0 -and $user.PasswordLastSet -ne $null -and $user.PasswordLastSet -lt $targetDate) {
            $matchedUsers += [PSCustomObject]@{
                Login    = $login
                FullName = if ($user.DisplayName) { $user.DisplayName } else { "ФИО не указано" }
            }
        }
    } catch {
        Write-Host "x Ошибка при чтении $login" -ForegroundColor Red
    }
}

$matchedCount = $matchedUsers.Count
Write-Host "Пользователей, подходящих под условие: $matchedCount`n" -ForegroundColor Cyan

# ===================== ФОРМИРОВАНИЕ СПИСКА (БЕЗ ИЗМЕНЕНИЙ) =====================
# Берем 100 человек, которым проставится галочка в будущем
$usersToProcess = $matchedUsers | Select-Object -First $maxToChange

if ($usersToProcess) {
    Write-Host "Формируем список из первых $maxToChange человек для оповещения..." -ForegroundColor Green
} else {
    Write-Host "Нет пользователей, подходящих под условия." -ForegroundColor Yellow
}

# ===================== ЛОГИРОВАНИЕ =====================
$currentDate = Get-Date -Format "dd.MM.yyyy HH:mm:ss"

$loginsListString = if ($usersToProcess) {
    ($usersToProcess | ForEach-Object { "  - $($_.Login) — $($_.FullName)" }) -join "`r`n"
} else {
    "  (Кандидатов нет)"
}

$plannedCount = if ($usersToProcess) { $usersToProcess.Count } else { 0 }

$logMessage = @"

=============== ТЕСТОВЫЙ ПРОГОН (ЧТЕНИЕ) ===============
Дата запуска: $currentDate
Всего логинов в файле: $totalCount
Попадают под условие (дата < 04.08.2026 и нет галочки): $matchedCount
Будут изменены при запуске боевого скрипта (лимит $maxToChange): $plannedCount
Список пользователей для оповещения:
$loginsListString
========================================================
"@

Write-Host $logMessage -ForegroundColor Cyan
Add-Content -Path $logPath -Value $logMessage