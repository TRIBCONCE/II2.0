cls
Import-Module ActiveDirectory
$OutputFile = "C:\Users\z-BorodinES\Desktop\Пользователи без division.csv"
$data = Get-ADUser -Filter "Enabled -eq 'True' -and (division -notlike '*')" -Properties SamAccountName, Name, Department, wWWHomePage, EmployeeID, Initials, DistinguishedName, EmployeeType | 
Where-Object {
    $_.EmployeeType -notin @('Vendor','Service') -and
    $_.SamAccountName -notmatch '^(z-|a-)' -and
    $_.SamAccountName -notlike '*$'
} |
Select-Object @{
    Name = "Логин"
    Expression = { $_.SamAccountName }
}, @{
    Name = "ФИО"
    Expression = { $_.Name }
}, @{
    Name = "Департамент"
    Expression = { $_.Department }
}, @{
    Name = "wwwhomepage"
    Expression = { $_.wWWHomePage }
}, @{
    Name = "EmployeeID"
    Expression = { $_.EmployeeID }
}, @{
    Name = "Initials"
    Expression = { $_.Initials }
},
@{
    Name = "OU"
    Expression = {
        $ouParts = $_.DistinguishedName -split ',' | Where-Object { $_ -match '^OU=' } | ForEach-Object { $_ -replace '^OU=' }
        [array]::Reverse($ouParts)
        $ouPath = $ouParts -join '/'
        $ouPath -replace '^Головной офис/', ''
    }
}
$data | Export-Csv -Path $OutputFile -NoTypeInformation -Encoding UTF8 -Delimiter ";"
Write-Host "Файл CSV сохранен: $OutputFile" -ForegroundColor Green
Invoke-Item $OutputFile 

