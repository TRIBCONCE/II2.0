# ===================== НАСТРОЙКИ (ТЕСТ) =====================
$testLogins = @("твой_логин_здесь", "еще_один_тестовый_логин_если_нужно") 
$logPath    = "C:\Path\To\TestLog.txt"   # Путь для тестового лога

# ===================== ОБРАБОТКА =====================
$totalCount = $testLogins.Count
$changedCount = 0

Write-Host "Запуск ТЕСТОВОГО скрипта. Всего логинов: $totalCount" -ForegroundColor Cyan

foreach ($login in $testLogins) {
    try {
        $user = Get-ADUser -Identity $login -Properties pwdLastSet -ErrorAction Stop
        
        # Если pwdLastSet равен 0, значит юзер уже обязан сменить пароль
        if ($user.pwdLastSet -eq 0) {
            Write-Host "У пользователя $login галочка УЖЕ СТОИТ. Пропускаем." -ForegroundColor Yellow
        } else {
            Set-ADUser -Identity $login -ChangePasswordAtLogon $true
            $changedCount++
            Write-Host "Галочка успешно установлена для: $login" -ForegroundColor Green
        }
    } catch {
        Write-Host "x Ошибка при обработке пользователя '$login': $_" -ForegroundColor Red
    }
}

# ===================== ЛОГИРОВАНИЕ =====================
$currentDate = Get-Date -Format "dd.MM.yyyy HH:mm:ss"
$logMessage = @"

=============== ТЕСТОВЫЙ ПРОГОН ===============
Дата запуска: $currentDate
Всего тестовых логинов проверено: $totalCount
Скольким логинам была поставлена галочка: $changedCount
================================================
"@

# Дублируем в консоль
Write-Host $logMessage -ForegroundColor Cyan

# Пишем в тестовый лог-файл
Add-Content -Path $logPath -Value $logMessage