cls
Import-Module ActiveDirectory

# ==============================================================================
# НАСТРОЙКИ
# ==============================================================================
$TargetExcelPath = "C:\Users\z-BorodinES\Desktop\Сайзинг RN.xlsx"
$TempCsvPath    = "C:\Users\z-BorodinES\Desktop\Sizing_Progress_Buffer_Fast.csv"
$SearchBase     = "OU=R: Departments,OU=Department FS Access Groups,OU=Файловые серверы ABCloud,OU=ABCloud,OU=Серверы и ресурсы,OU=Головной офис,DC=abb-win,DC=akbars,DC=ru"
$MaxThreads     = 6  # Оптимально для ночной работы без перегрузки сети

# ==============================================================================
# ШАГ 1: ПОЛУЧЕНИЕ ГРУПП ИЗ AD
# ==============================================================================
Write-Host "1. Получение групп из Active Directory..." -ForegroundColor Cyan
$allGroups = Get-ADGroup -Filter * -SearchBase $SearchBase -Properties department, info

$groupList = [System.Collections.Generic.List[PSCustomObject]]::new()
foreach ($g in $allGroups) {
    if (-not [string]::IsNullOrWhiteSpace($g.department) -and -not [string]::IsNullOrWhiteSpace($g.info)) {
        $cleanPath = ($g.info -replace "[\r\n]", " ").Trim()
        if ($cleanPath -match '(\\\\.*)') {
            $groupList.Add([PSCustomObject]@{
                GroupName  = $g.Name
                Department = $g.department
                Path       = $matches[1].TrimEnd('\')
            })
        }
    }
}

Write-Host "Валидных групп найдено: $($groupList.Count)" -ForegroundColor Green
if ($groupList.Count -eq 0) { return }

# ==============================================================================
# ШАГ 2: ПРОВЕРКА КЭША / ПРОДОЛЖЕНИЕ РАБОТЫ
# ==============================================================================
$processedPaths = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)

if (Test-Path $TempCsvPath) {
    Write-Host "Найден промежуточный буфер! Загрузка ранее посчитанных папок..." -ForegroundColor Yellow
    $existing = Import-Csv -Path $TempCsvPath -Delimiter ";" -Encoding UTF8
    foreach ($row in $existing) {
        [void]$processedPaths.Add($row.NotesPath)
    }
    Write-Host "Уже готово: $($processedPaths.Count) папок. Они будут пропущены." -ForegroundColor Green
} else {
    "BusinessBlock;GroupName;NotesPath;TargetPath;TotalGB;Old3YearsGB;Old5YearsGB" | Out-File -FilePath $TempCsvPath -Encoding UTF8
}

$tasksToRun = $groupList | Where-Object { -not $processedPaths.Contains($_.Path) }
Write-Host "Осталось обработать: $($tasksToRun.Count) папок" -ForegroundColor Cyan

# ==============================================================================
# ШАГ 3: МНОГОПОТОЧНЫЙ ПОДСЧЕТ ЗА 1 ПРОХОД + РЕЗОЛВ DFS TARGET
# ==============================================================================
if ($tasksToRun.Count -gt 0) {
    Write-Host "`n2. Запуск ночного сканирования ($MaxThreads потоков)..." -ForegroundColor Yellow

    $RunspacePool = [runspacefactory]::CreateRunspacePool(1, $MaxThreads)
    $RunspacePool.Open()
    $Jobs = @()

    $ScriptBlock = {
        param($Path, $GroupName, $Department)

        # 1. Быстрая проверка доступности
        if (-not (Test-Path -LiteralPath $Path -ErrorAction SilentlyContinue)) {
            return [PSCustomObject]@{
                BusinessBlock = "$Department"
                GroupName     = "$GroupName"
                NotesPath     = "$Path"
                TargetPath    = "НЕДОСТУПЕН"
                TotalGB       = "0"
                Old3YearsGB   = "0"
                Old5YearsGB   = "0"
            }
        }

        # 2. Определение TargetPath из кэша DFS (эмуляция вкладки DFS)
        $targetPath = $Path
        try {
            $cleanDfs = $Path.TrimEnd('\')
            $pkt = & dfsutil /pktinfo 2>$null
            
            $foundSection = $false
            foreach ($line in $pkt) {
                if ($line -match [regex]::Escape($cleanDfs)) {
                    $foundSection = $true
                    continue
                }
                if ($foundSection) {
                    # Ищем активный целевой сервер вида \\server\share
                    if ($line -match '(?i)^\s*(\\\\[^\s]+)') {
                        $targetPath = $matches[1].Trim()
                        break
                    }
                    if ($line -match '^\s*Entry:') { break }
                }
            }
        } catch { }

        # 3. Пороги дат в формате yyyyMMdd для быстрого числового сравнения
        $Date3Y = [int](Get-Date).AddYears(-3).ToString("yyyyMMdd")
        $Date5Y = [int](Get-Date).AddYears(-5).ToString("yyyyMMdd")

        # 4. Один изолированный запуск Robocopy с таймстемпами и байтами
        $psi = New-Object System.Diagnostics.ProcessStartInfo
        $psi.FileName = "robocopy.exe"
        $psi.Arguments = "`"$Path`" NUL /L /E /XJ /BYTES /FP /TS /NC /NJH /NJS /NDL /R:0 /W:0 /NP"
        $psi.UseShellExecute = $false
        $psi.CreateNoWindow = $true
        $psi.RedirectStandardOutput = $true
        $psi.StandardOutputEncoding = [System.Text.Encoding]::GetEncoding(866)

        $process = [System.Diagnostics.Process]::Start($psi)

        [long]$TotalBytes = 0
        [long]$Old3Bytes  = 0
        [long]$Old5Bytes  = 0

        # Читаем вывод построчно
        while (($line = $process.StandardOutput.ReadLine()) -ne $null) {
            $trimmed = $line.TrimStart()
            if ($trimmed.Length -gt 25) {
                $parts = $trimmed -split '\s+'
                if ($parts.Count -ge 3 -and $parts[0] -match '^\d+$') {
                    $bytes = [long]$parts[0]
                    $TotalBytes += $bytes

                    # parts[1] содержит дату вида 2021/04/15 или 2021-04-15
                    $rawDate = $parts[1] -replace '[\.\/\-]', ''
                    if ($rawDate.Length -ge 8) {
                        $fileDateNum = [int]$rawDate.Substring(0, 8)
                        if ($fileDateNum -lt $Date3Y) { $Old3Bytes += $bytes }
                        if ($fileDateNum -lt $Date5Y) { $Old5Bytes += $bytes }
                    }
                }
            }
        }

        $process.WaitForExit()
        $process.Dispose()

        return [PSCustomObject]@{
            BusinessBlock = "$Department"
            GroupName     = "$GroupName"
            NotesPath     = "$Path"
            TargetPath    = "$targetPath"
            TotalGB       = "$([math]::Round($TotalBytes / 1GB, 2))"
            Old3YearsGB   = "$([math]::Round($Old3Bytes  / 1GB, 2))"
            Old5YearsGB   = "$([math]::Round($Old5Bytes  / 1GB, 2))"
        }
    }

    foreach ($item in $tasksToRun) {
        $PowerShell = [powershell]::Create()
        $PowerShell.RunspacePool = $RunspacePool
        [void]$PowerShell.AddScript($ScriptBlock)
        [void]$PowerShell.AddArgument($item.Path)
        [void]$PowerShell.AddArgument($item.GroupName)
        [void]$PowerShell.AddArgument($item.Department)
        
        $Jobs += [PSCustomObject]@{
            Pipe    = $PowerShell
            Result  = $PowerShell.BeginInvoke()
            Checked = $false
        }
    }

    $completedCount = $processedPaths.Count
    $totalCount = $groupList.Count

    while ($Jobs.Result.IsCompleted -contains $false) {
        foreach ($job in $Jobs) {
            if ($job.Result.IsCompleted -and -not $job.Checked) {
                $job.Checked = $true
                $completedCount++
                
                try {
                    $res = $job.Pipe.EndInvoke($job.Result)
                    if ($res) {
                        # Мгновенно сохраняем строку в буфер
                        $csvLine = "$($res.BusinessBlock);$($res.GroupName);$($res.NotesPath);$($res.TargetPath);$($res.TotalGB);$($res.Old3YearsGB);$($res.Old5YearsGB)"
                        [System.IO.File]::AppendAllLines($TempCsvPath, [string[]]@($csvLine), [System.Text.Encoding]::UTF8)
                        
                        Write-Host "[$completedCount / $totalCount] Готово: $($res.NotesPath) | Всего: $($res.TotalGB) GB | >3 лет: $($res.Old3YearsGB) GB | >5 лет: $($res.Old5YearsGB) GB" -ForegroundColor Green
                    }
                } catch {
                    Write-Host "Ошибка в потоке: $($_.Exception.Message)" -ForegroundColor Red
                }
            }
        }
        Start-Sleep -Milliseconds 250
    }

    # Очистка потоков
    foreach ($job in $Jobs) { $job.Pipe.Dispose() }
    $RunspacePool.Close()
    $RunspacePool.Dispose()
}

# ==============================================================================
# ШАГ 4: ГЕНЕРАЦИЯ ФИНАЛЬНОГО EXCEL
# ==============================================================================
Write-Host "`n3. Генерация финального Excel файла..." -ForegroundColor Cyan

$finalData = Import-Csv -Path $TempCsvPath -Delimiter ";" -Encoding UTF8

$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    $wb = $excel.Workbooks.Add()
    $ws = $wb.Worksheets.Item(1)
    $ws.Name = "Диск R"

    # Заголовки таблицы
    $ws.Cells.Item(1, 1).Value2 = "Блок бизнеса"
    $ws.Cells.Item(1, 2).Value2 = "Имя группы"
    $ws.Cells.Item(1, 3).Value2 = "Путь(Notes)"
    $ws.Cells.Item(1, 4).Value2 = "TargetPath"
    $ws.Cells.Item(1, 5).Value2 = "Общий размер папки, в Gb"
    $ws.Cells.Item(1, 6).Value2 = "Файлы старше 3х лет, в Gb"
    $ws.Cells.Item(1, 7).Value2 = "Файлы старше 5 лет, в Gb"
    $ws.Range("A1:G1").Font.Bold = $true

    $row = 2
    foreach ($item in $finalData) {
        $ws.Cells.Item($row, 1).Value2 = "$($item.BusinessBlock)"
        $ws.Cells.Item($row, 2).Value2 = "$($item.GroupName)"
        $ws.Cells.Item($row, 3).Value2 = "$($item.NotesPath)"
        $ws.Cells.Item($row, 4).Value2 = "$($item.TargetPath)"
        $ws.Cells.Item($row, 5).Value2 = "$($item.TotalGB)"
        $ws.Cells.Item($row, 6).Value2 = "$($item.Old3YearsGB)"
        $ws.Cells.Item($row, 7).Value2 = "$($item.Old5YearsGB)"
        $row++
    }

    [void]$ws.Columns.AutoFit()

    if (Test-Path $TargetExcelPath) { Remove-Item $TargetExcelPath -Force }
    $wb.SaveAs($TargetExcelPath)
    $wb.Close($true)

    Write-Host "`nВСЁ ГОТОВО! Отчет сформирован: $TargetExcelPath" -ForegroundColor Green
}
catch {
    Write-Error "Ошибка создания Excel: $_"
}
finally {
    if ($null -ne $excel) {
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.GC]::Collect()
        [System.GC]::WaitForPendingFinalizers()
    }
