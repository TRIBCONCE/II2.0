cls

$ExcelFilePath = "C:\Users\z-BorodinES\Desktop\Задача Диск RN\Нахождение корневых групп безопасности\Копия Отчёт_по_группам_AD3 - Copy.xlsx"

Write-Host "1. Моментальное чтение данных из Excel (матричный метод)..." -ForegroundColor Cyan

$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    $wb = $excel.Workbooks.Open($ExcelFilePath)
    $ws = $wb.Worksheets.Item(1)

    $lastRow = $ws.Cells.SpecialCells(11).Row # 11 = xlCellTypeLastCell

    $Data = @()
    
    # ЧИТАЕМ ВЕСЬ ДИАПАЗОН СРАЗУ В ОПЕРАТИВНУЮ ПАМЯТЬ (в 100 раз быстрее)
    if ($lastRow -ge 2) {
        $dataMatrix = $ws.Range("A2:D$lastRow").Value2

        for ($r = 1; $r -le ($lastRow - 1); $r++) {
            
            # Защита от сдвига массива, если в Excel всего одна строка с данными
            if ($lastRow -eq 2) {
                $block   = if ($null -ne $dataMatrix[2]) { $dataMatrix[2].ToString() } else { "" }
                $rawPath = if ($null -ne $dataMatrix[3]) { $dataMatrix[3].ToString() } else { "" }
                $status  = if ($null -ne $dataMatrix[4]) { $dataMatrix[4].ToString() } else { "" }
            } else {
                $block   = if ($null -ne $dataMatrix[$r, 2]) { $dataMatrix[$r, 2].ToString() } else { "" }
                $rawPath = if ($null -ne $dataMatrix[$r, 3]) { $dataMatrix[$r, 3].ToString() } else { "" }
                $status  = if ($null -ne $dataMatrix[$r, 4]) { $dataMatrix[$r, 4].ToString() } else { "" }
            }

            if ($status -match "Существует" -and -not [string]::IsNullOrWhiteSpace($rawPath)) {
                $normPath = $rawPath.Trim().TrimEnd('\').ToLower()
                $block    = $block.Trim()

                $Data += [PSCustomObject]@{
                    RowIndex = ($r + 1)
                    RawPath  = $rawPath
                    NormPath = $normPath
                    Block    = $block
                }
            }
        }
    }

    Write-Host "Считано валидных строк для анализа: $($Data.Count)" -ForegroundColor Yellow

    # ==============================================================================
    # АЛГОРИТМ ПОИСКА КОРНЕЙ (В ОПЕРАТИВНОЙ ПАМЯТИ)
    # ==============================================================================
    Write-Host "2. Вычисление математических корней (учет смешанных деревьев)..." -ForegroundColor Cyan
    
    $TaintedPaths = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)

    # 1. Ищем испорченных родителей (внутри которых есть чужой блок)
    foreach ($parent in $Data) {
        foreach ($child in $Data) {
            if ($child.NormPath.StartsWith($parent.NormPath + "\") -and $child.NormPath.Length -gt $parent.NormPath.Length) {
                if ($parent.Block -ne $child.Block) {
                    [void]$TaintedPaths.Add($parent.NormPath)
                    break 
                }
            }
        }
    }

    Write-Host "Найдено 'смешанных' родителей (дисквалифицированы): $($TaintedPaths.Count)" -ForegroundColor Magenta

    # 2. Сортируем пути по длине и находим чистые корни
    $SortedData = $Data | Sort-Object { $_.NormPath.Length }
    
    $ValidRoots = [System.Collections.Generic.List[string]]::new()
    $RowsToColor = [System.Collections.Generic.List[int]]::new()

    foreach ($item in $SortedData) {
        if ($TaintedPaths.Contains($item.NormPath)) { continue }

        $isDuplicate = $false
        foreach ($root in $ValidRoots) {
            if ($item.NormPath -eq $root) {
                $isDuplicate = $true
                break
            }
        }
        if ($isDuplicate) { continue }

        $isChildOfRoot = $false
        foreach ($root in $ValidRoots) {
            if ($item.NormPath.StartsWith($root + "\")) {
                $isChildOfRoot = $true
                break
            }
        }
        if ($isChildOfRoot) { continue }

        $ValidRoots.Add($item.NormPath)
        $RowsToColor.Add($item.RowIndex)
    }

    Write-Host "Вычислено итоговых корней для окрашивания: $($RowsToColor.Count)" -ForegroundColor Green

    # ==============================================================================
    # ПРИМЕНЕНИЕ ЦВЕТА В EXCEL
    # ==============================================================================
    Write-Host "3. Окрашивание строк в серый цвет..." -ForegroundColor Cyan

    $ws.Range("A2:E$lastRow").Interior.ColorIndex = 0 # Быстрая очистка старого цвета

    $GrayColor = 14277081
    foreach ($rowIndex in $RowsToColor) {
        $ws.Range("A${rowIndex}:E${rowIndex}").Interior.Color = $GrayColor
    }

    $wb.Save()
    Write-Host "`nВСЁ ГОТОВО! Файл сохранен." -ForegroundColor Green

}
catch {
    Write-Host "[!] Ошибка: $_" -ForegroundColor Red
}
finally {
    if ($null -ne $wb) { $wb.Close($false) }
    $excel.Quit()
    [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
    [System.GC]::Collect()
    [System.GC]::WaitForPendingFinalizers()
}
